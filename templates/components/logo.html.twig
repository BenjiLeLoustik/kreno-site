{% set size = size|default(36) %}
{% set light = light|default(false) %}
{% set badge = badge|default(null) %}
<span class="logo{{ light ? ' logo--light' : '' }}">
    {% if size > 0 %}
        <svg class="logo__mark" width="{{ size }}" height="{{ size }}" viewBox="0 0 100 100" aria-hidden="true">
            <rect width="100" height="100" rx="22" fill="#FF5A3C"></rect>
            <line x1="32" y1="22" x2="32" y2="78" stroke="#FFFFFF" stroke-width="11" stroke-linecap="round"></line>
            <line x1="36" y1="52" x2="70" y2="22" stroke="#FFFFFF" stroke-width="11" stroke-linecap="round"></line>
            <line x1="36" y1="52" x2="64" y2="76" stroke="#FFFFFF" stroke-width="9" stroke-linecap="round"></line>
            <circle cx="36" cy="52" r="8" fill="#1B1F3B"></circle>
        </svg>
    {% endif %}
    <span class="logo__word">kréno</span>
    {% if badge %}
        <span class="logo__badge logo__badge--{{ badge }}">{{ badge }}</span>
    {% endif %}
</span>