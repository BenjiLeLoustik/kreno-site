{% extends 'layouts/base.html.twig' %}

{% block body_class %}layout-admin{% endblock %}

{% block layout_javascripts %}
    <script src="{{ asset('js/admin.js') }}" defer></script>
{% endblock %}

{% block body %}
    {% set user = app_user() %}
    {% set section = admin_section|default('dashboard') %}

    <div class="admin">
        <aside class="admin-side">
            <a href="{{ path('admin_dashboard') }}" class="admin-side__brand" aria-label="Kréno, administration">
                {% include 'components/logo.html.twig' with { size: 0, light: true, badge: 'admin' } %}
            </a>
            <nav class="admin-nav" aria-label="Administration">
                {% for item in admin_nav() %}
                    {% if is_granted(item.role) and route_exists(item.route) %}
                        <a href="{{ path(item.route) }}" class="admin-nav__link{{ item.key == section ? ' admin-nav__link--active' : '' }}"{{ item.key == section ? ' aria-current="page"' : '' }}>
                            <i data-lucide="{{ item.icon }}" class="admin-nav__icon"></i>
                            <span class="admin-nav__label">{{ item.label }}</span>
                            {% if item.badge > 0 %}
                                <span class="admin-nav__badge">{{ item.badge }}</span>
                            {% endif %}
                        </a>
                    {% endif %}
                {% endfor %}
            </nav>
            <div class="admin-side__footer">
                {% if user %}
                    <span class="admin-side__user">Connecté : {{ user.firstName }} {{ user.lastName|first }}.</span>
                {% endif %}
                <div class="admin-side__actions">
                    <a href="{{ path('home_index') }}" class="admin-side__action">
                        <i data-lucide="external-link" class="admin-nav__icon"></i>
                        Voir le site
                    </a>
                    <form method="post" action="{{ logout_path() }}" class="admin-side__logout">
                        <button type="submit" class="admin-side__action">
                            <i data-lucide="log-out" class="admin-nav__icon"></i>
                            Déconnexion
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="admin-main">
            {% for type, messages in flashes() %}
                {% for message in messages %}
                    <div class="admin-flash admin-flash--{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}