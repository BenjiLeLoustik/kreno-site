{% extends 'layouts/base.html.twig' %}

{% block title %}
    {{ translate('Inscription · Espace pro') }}
{% endblock %}

{% block body_class %}layout-signup{% endblock %}

{% block layout_javascripts %}
    <script src="{{ asset('js/pro.js') }}" defer></script>
{% endblock %}

{% block body %}
    {% set site = website() %}
    <div class="signup">
        <aside class="signup-side">
            <a href="{{ path('pro_landing') }}" class="signup-side__brand" aria-label="{{ translate('{site} Pro, accueil', {site: site.siteName}) }}">
                {% include 'components/logo.html.twig' with {
                    size: 34,
                    light: true,
                    badge: 'pro'
                } %}
            </a>
            <div class="signup-side__intro">
                <h2 class="signup-side__title">
                    {{ translate('Créer mon espace pro') }}
                </h2>
                <span class="signup-side__lead">
                    {{ translate('Environ 5 minutes. Vos réponses sont enregistrées à chaque étape.') }}
                </span>
            </div>
            <ol class="signup-steps" aria-label="{{ translate('Étapes de l\'inscription') }}">
                {% for item in signup.steps %}
                    <li class="signup-steps__item signup-steps__item--{{ item.state }}"{{ item.state == 'current' ? ' aria-current="step"' : '' }}>
                        <span class="signup-steps__mark" aria-hidden="true">
                            {% if item.state == 'done' %}
                                ✓
                            {% else %}
                                {{ item.number }}
                            {% endif %}
                        </span>
                        <span class="signup-steps__text">
                            {% if item.reachable and item.state != 'current' %}
                                <a href="{{ path('pro_signup_step', { step: item.key }) }}" class="signup-steps__label">
                                    {{ item.label }}
                                </a>
                            {% else %}
                                <b class="signup-steps__label">
                                    {{ item.label }}
                                </b>
                            {% endif %}
                            <span class="signup-steps__sub">
                                {{ item.sub }}
                            </span>
                        </span>
                    </li>
                {% endfor %}
            </ol>
            <div class="signup-side__note">
                <b>
                    {{ translate('Sans engagement') }}
                </b>
                <span class="signup-side__note-text">
                    {{ translate('Vous changez de formule quand vous voulez, depuis votre espace.') }}
                </span>
                {% if site.contactEmail %}
                    <span class="signup-side__contact">
                        {{ translate('Une question ? {contactEmail}', {contactEmail: site.contactEmail}) }}
                    </span>
                {% endif %}
            </div>
        </aside>

        <main class="signup-main">
            <div class="signup-panel">
                <div class="signup-top">
                    <span class="signup-top__step">
                        {% if signup.step == 'pending' %}
                            {{ translate('Inscription envoyée') }}
                        {% else %}
                            {{ translate('Étape {signupNumber} sur {signupTotal}', {
                                signupNumber: signup.number,
                                signupTotal: signup.total
                            }) }}
                        {% endif %}
                    </span>
                    {% if signup.loggedIn %}
                        <form method="post" action="{{ logout_path() }}">
                            <button type="submit" class="signup-top__logout">
                                {{ translate('Se déconnecter') }}
                            </button>
                        </form>
                    {% else %}
                        <span class="signup-top__login">
                            {{ translate('Déjà inscrit ? {open}Se connecter{close}', {
                                open: '<a href="' ~ path('pro_login')|e('html_attr') ~ '" class="signup-top__link">',
                                close: '</a>'
                            })|raw }}
                        </span>
                    {% endif %}
                </div>

                {% for type, messages in flashes() %}
                    {% for message in messages %}
                        <div class="pro-flash pro-flash--{{ type }}" role="status">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <div class="signup-head">
                    <h1 class="signup-title">
                        {% block heading %}{% endblock %}
                    </h1>
                    <span class="signup-lead">
                        {% block lead %}{% endblock %}
                    </span>
                </div>

                {% block content %}{% endblock %}
            </div>
        </main>
    </div>
{% endblock %}