{% extends 'layouts/base.html.twig' %}

{% block body_class %}layout-front{% endblock %}

{% block body %}
    {% set nav = navigation() %}
    {% set user = app_user() %}
    {% set site = website() %}

    <header class="site-header {% block header_class %}{% endblock %}">
        <div class="site-header__inner">
            <a href="{{ path('home_index') }}" class="site-header__brand" aria-label="{{ translate('{site}, accueil', {site: site.siteName}) }}">
                {% include 'components/logo.html.twig' %}
            </a>
            <span class="site-header__toggle">
                {% include 'components/menu_toggle.html.twig' with {
                    target: 'site-nav'
                } only %}
            </span>
            <nav id="site-nav" class="site-header__nav" aria-label="Navigation principale">
                <a href="{{ path('page_how_it_works') }}" class="site-header__link">
                    {{ translate('Comment ça marche') }}
                </a>
                <a href="{{ path('pro_landing') }}" class="site-header__link">
                    {{ translate('Pour les pros') }}
                </a>
                {% if user %}
                    <a href="{{ path('account_index') }}" class="site-header__link">
                        {{ translate('Mon compte') }}
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="site-header__link">
                        {{ translate('Se connecter') }}
                    </a>
                {% endif %}
                <a href="{{ path('pro_slot_new') }}" class="btn btn--outline site-header__cta">
                    {{ translate('Publier un créneau') }}
                </a>
            </nav>
        </div>
    </header>

    {% for type, messages in flashes() %}
        {% for message in messages %}
            <div class="flash flash--{{ type }}" role="status">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main id="top" class="site-main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="site-footer__grid">
            <div class="site-footer__intro">
                <a href="{{ path('home_index') }}" class="site-footer__brand" aria-label="{{ site.siteName }}, accueil">
                    {% include 'components/logo.html.twig' with {
                        size: 34
                    } %}
                </a>
                <p class="site-footer__pitch">
                    {{ site.siteDescription }}
                </p>
                <a href="{{ path('pro_landing') }}" class="btn btn--outline btn--small">
                    {{ translate('Vous êtes un pro ? Rejoindre {site}', {site: site.siteName}) }}
                </a>
            </div>

            <nav class="site-footer__column" aria-label="{{ site.siteName }}">
                <b class="site-footer__title">{{ site.siteName }}</b>
                <a href="{{ path('page_how_it_works') }}" class="site-footer__link">
                    {{ translate('Comment ça marche') }}
                </a>
                <a href="{{ path('search_index') }}" class="site-footer__link">
                    {{ translate('Tous les créneaux') }}
                </a>
                <a href="{{ path('app_signup') }}" class="site-footer__link">
                    {{ translate('Créer un compte') }}
                </a>
                <a href="{{ path('page_help') }}" class="site-footer__link">
                    {{ translate('Aide et contact') }}
                </a>
            </nav>

            <nav class="site-footer__column" aria-label="{{ translate('Professionnels') }}">
                <b class="site-footer__title">
                    {{ translate('Pros') }}
                </b>
                <a href="{{ path('pro_landing') }}" class="site-footer__link">
                    {{ translate('Pour les pros') }}
                </a>
                <a href="{{ path('pro_landing') }}#tarifs" class="site-footer__link">
                    {{ translate('Tarifs') }}
                </a>
                <a href="{{ path('pro_signup') }}" class="site-footer__link">
                    {{ translate('Créer mon espace pro') }}
                </a>
                <a href="{{ path('pro_login') }}" class="site-footer__link">
                    {{ translate('Connexion pro') }}
                </a>
            </nav>

            <nav class="site-footer__column" aria-label="{{ translate('Catégories') }}">
                <b class="site-footer__title">
                    {{ translate('Catégories') }}
                </b>
                {% for category in nav.categories|slice(0, 6) %}
                    <a href="{{ path('category_show', { slug: category.slug }) }}" class="site-footer__link">
                        {{ category.name }}
                    </a>
                {% endfor %}
            </nav>

            <nav class="site-footer__column" aria-label="{{ translate('Villes') }}">
                <b class="site-footer__title">
                    {{ translate('Villes') }}
                </b>
                {% for city in nav.cities|slice(0, 6) %}
                    <a href="{{ path('city_show', { slug: city.slug }) }}" class="site-footer__link">
                        {{ city.name }}
                    </a>
                {% endfor %}
            </nav>
        </div>

        <div class="site-footer__bottom">
            <span>
                {{ translate('© {now} {site} · Fait à Lyon', {
                    now: 'now'|date('Y'),
                    site: site.siteName
                }) }}
                {% if site.contactEmail %} ·
                    <a href="mailto:{{ site.contactEmail }}">
                        {{ site.contactEmail }}
                    </a>
                {% endif %}
            </span>
            <nav class="site-footer__legal" aria-label="{{ translate('Informations légales') }}">
                <a href="{{ path('page_legal', { document: 'mentions' }) }}">
                    {{ translate('Mentions légales') }}
                </a>
                <a href="{{ path('page_legal', { document: 'cgu' }) }}">
                    {{ translate('CGU') }}
                </a>
                <a href="{{ path('page_legal', { document: 'privacy' }) }}">
                    {{ translate('Confidentialité') }}
                </a>
                <a href="{{ path('page_legal', { document: 'cgv' }) }}">
                    {{ translate('Conditions pros') }}
                </a>
            </nav>
            {% include 'components/locale_switcher.html.twig' with {
                variant: 'light'
            } only %}
        </div>
    </footer>
{% endblock %}