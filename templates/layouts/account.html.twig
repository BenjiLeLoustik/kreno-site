{% extends 'layouts/front.html.twig' %}

{% block header_class %}site-header--compact{% endblock %}

{% block content %}
    {% set sections = [
        { key: 'dashboard', label: 'Tableau de bord', route: 'account_index', icon: 'layout-dashboard' },
        { key: 'bookings', label: 'Mes réservations', route: 'account_bookings', icon: 'calendar-check' },
        { key: 'alerts', label: 'Mes alertes', route: 'account_alerts', icon: 'bell-ring' },
        { key: 'follows', label: 'Établissements suivis', route: 'account_follows', icon: 'heart' },
        { key: 'notifications', label: 'Notifications', route: 'account_notifications', icon: 'inbox' },
        { key: 'reports', label: 'Signalements', route: 'account_reports', icon: 'flag' },
        { key: 'settings', label: 'Réglages', route: 'account_settings', icon: 'settings' },
    ] %}

    <div class="account">
        <nav class="account-nav" aria-label="Mon compte">
            <span class="account-nav__title">Mon compte</span>
            {% for section in sections %}
                {% set current = section.key == account_section|default('') %}
                <a href="{{ path(section.route) }}" class="account-nav__link{{ current ? ' account-nav__link--active' : '' }}"{{ current ? ' aria-current="page"' : '' }}>
                    <i data-lucide="{{ section.icon }}" class="account-nav__icon"></i>
                    <span class="account-nav__label">{{ section.label }}</span>
                    {% if section.key == 'notifications' and unreadNotifications|default(0) > 0 %}
                        <span class="account-nav__badge">{{ unreadNotifications }}</span>
                    {% endif %}
                </a>
            {% endfor %}
            <a href="{{ path('page_help') }}" class="account-nav__link">
                <i data-lucide="life-buoy" class="account-nav__icon"></i>
                <span class="account-nav__label">Aide</span>
            </a>
            <form method="post" action="{{ logout_path() }}" class="account-nav__logout">
                <button type="submit" class="account-nav__link account-nav__link--danger">
                    <i data-lucide="log-out" class="account-nav__icon"></i>
                    <span class="account-nav__label">Se déconnecter</span>
                </button>
            </form>
        </nav>

        <div class="account-main">
            {% block account_content %}{% endblock %}
        </div>
    </div>
{% endblock %}