{% extends 'layouts/front.html.twig' %}

{% block header_class %}site-header--compact{% endblock %}

{% block content %}
    {% set items = account_nav()|filter(item => route_exists(item.route)) %}
    {% set currentItem = items|filter(item => item.key == account_section|default(''))|first %}

    <div class="account">
        <aside class="account-side">
            <button type="button" class="account-side__toggle" aria-controls="account-nav" aria-expanded="false" data-toggle="account-nav">
                <i data-lucide="{{ currentItem ? currentItem.icon : 'user' }}" class="account-nav__icon"></i>
                <span class="account-side__current">{{ currentItem ? currentItem.label : 'Mon compte' }}</span>
                <i data-lucide="chevron-down" class="account-side__chevron"></i>
            </button>

            <nav id="account-nav" class="account-nav" aria-label="Mon compte">
                <span class="account-nav__title">Mon compte</span>
                {% for item in items %}
                    {% set current = item.key == account_section|default('') %}
                    <a href="{{ path(item.route) }}" class="account-nav__link{{ current ? ' account-nav__link--active' : '' }}"{{ current ? ' aria-current="page"' : '' }}>
                        <i data-lucide="{{ item.icon }}" class="account-nav__icon"></i>
                        <span class="account-nav__label">{{ item.label }}</span>
                        {% if item.badge > 0 %}
                            <span class="account-nav__badge">{{ item.badge }}</span>
                        {% endif %}
                    </a>
                {% endfor %}
                {% set accountUser = app_user() %}
                {% set isPro = accountUser and accountUser.memberships is not empty %}
                {% set isStaff = is_granted('ROLE_SUPPORT') %}
                {% if isPro or isStaff %}
                    <span class="account-nav__separator" aria-hidden="true"></span>
                    {% if isPro %}
                        <a href="{{ path('pro_dashboard') }}" class="account-nav__link account-nav__link--space">
                            <i data-lucide="briefcase" class="account-nav__icon"></i>
                            <span class="account-nav__label">Mon espace pro</span>
                            <i data-lucide="arrow-up-right" class="account-nav__icon account-nav__icon--end"></i>
                        </a>
                    {% endif %}
                    {% if isStaff %}
                        <a href="{{ path('admin_dashboard') }}" class="account-nav__link account-nav__link--space">
                            <i data-lucide="shield-check" class="account-nav__icon"></i>
                            <span class="account-nav__label">Administration</span>
                            <i data-lucide="arrow-up-right" class="account-nav__icon account-nav__icon--end"></i>
                        </a>
                    {% endif %}
                {% endif %}
                <span class="account-nav__separator" aria-hidden="true"></span>
                <a href="{{ path('page_help') }}" class="account-nav__link">
                    <i data-lucide="life-buoy" class="account-nav__icon"></i>
                    <span class="account-nav__label">Aide</span>
                </a>
                <form method="post" action="{{ logout_path() }}" class="account-nav__logout">
                    <button type="submit" class="account-nav__link account-nav__link--danger">
                        <i data-lucide="log-out" class="account-nav__icon"></i>
                        <span class="account-nav__label">Se déconnecter</span>
                    </button>
                </form>
            </nav>
        </aside>

        <div class="account-main">
            {% block account_content %}{% endblock %}
        </div>
    </div>
{% endblock %}