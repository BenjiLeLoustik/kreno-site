<label for="{{ id }}" class="form-field">
    {{ label }}
    <input id="{{ id }}" type="password" name="{{ name }}" required minlength="12" autocomplete="new-password" class="form-input" placeholder="12 caractères minimum" data-password-input>
</label>
<div class="password-meter" data-password-meter>
    <span class="password-meter__bars">
        {% for index in 1..4 %}
            <span class="password-meter__bar" data-password-bar></span>
        {% endfor %}
    </span>
    <span class="password-meter__text" data-password-text>
        {{ translate('Au moins 12 caractères, avec des lettres et des chiffres.') }}
    </span>
</div>