{% extends pro ? 'layouts/pro-auth.html.twig' : 'layouts/auth.html.twig' %}

{% block title %}
    Nouveau mot de passe · {{ website().siteName }}{{ pro ? ' Pro' : '' }}
    {{ translate('Nouveau mot de passe · {site}', {
        site: website().siteName ~ pro ? 'Pro' : ''
    }) }}
{% endblock %}

{% block javascripts %}
    {% if valid %}
        <script src="{{ asset('js/pages/security/password.js') }}" defer></script>
    {% endif %}
{% endblock %}

{% block heading %}
    {% if valid %}
        {{ translate('Nouveau mot de passe') }}
    {% else %}
        {{ translate('Lien expiré') }}
    {% endif %}
{% endblock %}

{% block lead %}
    {%- if valid -%}
        {%- if pro -%}
            {{ translate('Choisissez un nouveau mot de passe pour {email}.', {email: email}) }}
        {%- else -%}
            {{ translate('Choisis un nouveau mot de passe pour {email}.', {email: email}) }}
        {%- endif -%}
    {%- else -%}
        {%- if pro -%}
            {{ translate('Ce lien n\'est plus valable : il a expiré ou a déjà été utilisé.') }}
        {%- else -%}
            {{ translate('Ce lien n\'est plus valable : il a expiré ou a déjà servi.') }}
        {%- endif -%}
    {%- endif -%}
{% endblock %}

{% block content %}
    {% if valid %}
        <form method="post" action="{{ path(pro ? 'pro_reset_password_submit' : 'app_reset_password_submit', { token: token }) }}" class="form">
            {{ csrf_field('account')|raw }}
            {% include 'front/security/_password_field.html.twig' with {
                id: 'reset-password',
                name: 'password',
                label: translate('Nouveau mot de passe')
            } %}
            <label for="reset-confirmation" class="form-field">
                {{ translate('Confirmation') }}
                <input id="reset-confirmation" type="password" name="passwordConfirmation" required minlength="12" autocomplete="new-password" class="form-input" data-password-confirmation>
            </label>
            <button type="submit" class="btn btn--primary form-submit">
                {{ translate('Enregistrer le mot de passe') }}
            </button>
        </form>
    {% else %}
        <div class="auth-state auth-state--error">
            <i data-lucide="link-2-off" class="auth-state__icon"></i>
            <span>
                {% if pro %}
                    {{ translate('Demandez un nouveau lien : il sera valable 1 heure.') }}
                {% else %}
                    {{ translate('Demande un nouveau lien : il sera valable 1 heure.') }}
                {% endif %}
            </span>
        </div>
        <a href="{{ path(pro ? 'pro_forgot_password' : 'app_forgot_password') }}" class="btn btn--primary form-submit">
            {{ translate('Recevoir un nouveau lien') }}
        </a>
    {% endif %}
{% endblock %}