{% extends pro ? 'layouts/pro-auth.html.twig' : 'layouts/auth.html.twig' %}

{% block title %}Nouveau mot de passe · {{ website().siteName }}{{ pro ? ' Pro' : '' }}{% endblock %}

{% block javascripts %}
    {% if valid %}<script src="{{ asset('js/pages/security/password.js') }}" defer></script>{% endif %}
{% endblock %}

{% block heading %}{{ valid ? 'Nouveau mot de passe' : 'Lien expiré' }}{% endblock %}

{% block lead %}
    {%- if valid -%}
        {{ pro ? 'Choisissez un nouveau mot de passe pour ' ~ email ~ '.' : 'Choisis un nouveau mot de passe pour ' ~ email ~ '.' }}
    {%- else -%}
        {{ pro ? 'Ce lien n\'est plus valable : il a expiré ou a déjà été utilisé.' : 'Ce lien n\'est plus valable : il a expiré ou a déjà servi.' }}
    {%- endif -%}
{% endblock %}

{% block content %}
    {% if valid %}
        <form method="post" action="{{ path(pro ? 'pro_reset_password_submit' : 'app_reset_password_submit', { token: token }) }}" class="form">
            {{ csrf_field('account')|raw }}
            {% include 'front/security/_password_field.html.twig' with { id: 'reset-password', name: 'password', label: 'Nouveau mot de passe' } %}
            <label for="reset-confirmation" class="form-field">
                Confirmation
                <input id="reset-confirmation" type="password" name="passwordConfirmation" required minlength="12" autocomplete="new-password" class="form-input" data-password-confirmation>
            </label>
            <button type="submit" class="btn btn--primary form-submit">Enregistrer le mot de passe</button>
        </form>
    {% else %}
        <div class="auth-state auth-state--error">
            <i data-lucide="link-2-off" class="auth-state__icon"></i>
            <span>{{ pro ? 'Demandez un nouveau lien : il sera valable 1 heure.' : 'Demande un nouveau lien : il sera valable 1 heure.' }}</span>
        </div>
        <a href="{{ path(pro ? 'pro_forgot_password' : 'app_forgot_password') }}" class="btn btn--primary form-submit">Recevoir un nouveau lien</a>
    {% endif %}
{% endblock %}