{% extends pro ? 'layouts/pro-auth.html.twig' : 'layouts/auth.html.twig' %}

{% block title %}
    Mot de passe oublié · {{ website().siteName }}{{ pro ? ' Pro' : '' }}
    {{ translate('Mot de passe oublié · {site}', {
        site: website().siteName ~ pro ? 'Pro' : ''
    }) }}
{% endblock %}

{% block heading %}
    {{ translate('Mot de passe oublié') }}
{% endblock %}

{% block lead %}
    {% if pro %}
        {{ translate('Indiquez votre adresse e-mail : nous vous envoyons un lien pour en choisir un nouveau.') }}
    {% else %}
        {{ translate('Indique ton adresse e-mail : on t\'envoie un lien pour en choisir un nouveau.') }}
    {% endif %}
{% endblock %}

{% block content %}
    {% if sent %}
        <div class="auth-state auth-state--success">
            <i data-lucide="mail-check" class="auth-state__icon"></i>
            <b>
                {% if pro %}
                    {{ translate('Vérifiez votre boîte e-mail') }}
                {% else %}
                    {{ translate('Regarde ta boîte e-mail') }}
                {% endif %}
            </b>
            <span>
                {{ translate("Si un compte existe pour {email}, un lien de réinitialisation vient d'être envoyé.", {email: email}) }}
                {% if pro %}
                    {{ translate('Il est valable 1 heure.') }}
                {% else %}
                    {{ translate('Il est valable 1 heure, pense à vérifier tes indésirables.') }}
                {% endif %}
            </span>
        </div>
    {% endif %}

    <form method="post" action="{{ path(pro ? 'pro_forgot_password_submit' : 'app_forgot_password_submit') }}" class="form">
        {{ csrf_field('account')|raw }}
        <label for="forgot-email" class="form-field">
            {{ translate('Adresse e-mail') }}
            <input id="forgot-email" type="email" name="email" value="{{ email }}" required autofocus autocomplete="email" class="form-input">
        </label>
        <button type="submit" class="btn btn--primary form-submit">
            {% if send %}
                {{ translate('Renvoyer le lien') }}
            {% else %}
                {{ translate('Recevoir le lien') }}
            {% endif %}
        </button>
    </form>

    {% if not pro %}
        <span class="login-main__signup">
            <a href="{{ path('app_login') }}" class="login-main__signup-link">
                {{ translate('← Retour à la connexion') }}
            </a>
        </span>
    {% endif %}
{% endblock %}