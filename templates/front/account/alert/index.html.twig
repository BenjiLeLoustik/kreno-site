{% extends 'layouts/account.html.twig' %}

{% set account_section = 'alerts' %}

{% block title %}Mes alertes · {{ website().siteName }}{% endblock %}

{% block account_content %}
    <header class="account-head">
        <h1 class="account-head__title">Mes alertes</h1>
        <p class="account-head__subtitle">Un e-mail et une notification dès qu'un créneau se libère dans vos catégories, près de chez vous et aux heures qui vous arrangent. Jusqu'à {{ maxAlerts }} alertes.</p>
    </header>

    {% for alert in alerts %}
        <section class="account-card alert-card{{ alert.enabled ? '' : ' alert-card--paused' }}">
            <div class="account-section__head">
                <h2 class="account-section__title">{{ alert.label }}</h2>
                <span class="account-status account-status--{{ alert.enabled ? 'coming' : 'closed' }}">{{ alert.enabled ? 'Active' : 'En pause' }}</span>
            </div>
            <p class="account-card__text">
                {{ alert.categories is not empty ? alert.categories|map(category => category.name)|join(', ') : 'Toutes catégories' }}
                · {{ alert.city ? alert.city.name : 'toutes les villes' }}
                · à moins de {{ alert.radiusKm }} km
                {% if alert.startTime and alert.endTime %} · entre {{ alert.startTime }} et {{ alert.endTime }}{% endif %}
                {% if alert.maxPrice %} · {{ (alert.maxPrice / 100)|number_format(0, ',', ' ') }} € maximum{% endif %}
            </p>
            <div class="alert-card__actions">
                <details class="alert-card__edit">
                    <summary class="alert-card__toggle">Modifier</summary>
                    {% include 'front/account/alert/_form.html.twig' with { alert: alert } %}
                </details>
                <form method="post" action="{{ path('account_alert_delete', { id: alert.id }) }}" class="alert-card__delete">
                    {{ csrf_field('account')|raw }}
                    <button type="submit" class="alert-card__remove">Supprimer</button>
                </form>
            </div>
        </section>
    {% else %}
        <div class="account-empty">
            <p class="account-empty__text">Vous n'avez pas encore d'alerte. Créez-en une pour ne plus rater les créneaux libérés.</p>
        </div>
    {% endfor %}

    {% if canCreate %}
        <section class="account-card">
            <h2 class="account-section__title">Nouvelle alerte</h2>
            {% include 'front/account/alert/_form.html.twig' with { alert: null } %}
        </section>
    {% else %}
        <p class="account-card__muted">Vous avez atteint {{ maxAlerts }} alertes : supprimez-en une pour en créer une nouvelle.</p>
    {% endif %}
{% endblock %}