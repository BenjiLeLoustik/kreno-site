{% extends 'layouts/account.html.twig' %}

{% set account_section = 'follows' %}

{% block title %}
    Établissements suivis · {{ website().siteName }}
    {{ translate('Établissements suivis · {site}', {site: website().siteName}) }}
{% endblock %}

{% block account_content %}
    <header class="account-head">
        <h1 class="account-head__title">
            {{ translate('Établissements suivis') }}
        </h1>
        <p class="account-head__subtitle">
            {{ translate('Vous êtes prévenu dès qu\'ils publient un créneau.') }}
        </p>
    </header>

    {% if follows is not empty %}
        <div class="follow-grid">
            {% for shop in follows %}
                {% set url = shop.city ? path('shop_show', {
                    city: shop.city.slug,
                    slug: shop.slug
                }) : null %}

                <article class="follow-card">
                    {% if shop.cover %}
                        <img src="{{ shop.cover }}" alt="" class="follow-card__cover" loading="lazy">
                    {% else %}
                        <span class="follow-card__cover follow-card__cover--empty" aria-hidden="true">
                            {{ shop.name|first|upper }}
                        </span>
                    {% endif %}
                    <div class="follow-card__body">
                        {% if url %}
                            <a href="{{ url }}" class="follow-card__name">
                                {{ shop.name }}
                            </a>
                        {% else %}
                            <b class="follow-card__name">
                                {{ shop.name }}
                            </b>
                        {% endif %}
                        <span class="follow-card__meta">
                            {{ shop.category ? shop.category.name : '' }}
                            {% if shop.category and shop.city %}
                                · {% endif %}
                            {{ shop.city ? shop.city.name : '' }}
                        </span>
                        <span class="follow-card__slots{{ shop.availableSlots > 0 ? ' follow-card__slots--available' : '' }}">
                            {{ translate("{count, plural, =0 {Rien pour l'instant} one {# créneau libre} other {# créneaux libres}}", {
                                count: shop.availableSlots
                            }) }}
                        </span>
                        {% if shop.openNow.label %}
                            <span class="follow-card__hours">
                                {{ shop.openNow.label }}
                            </span>
                        {% endif %}
                    </div>
                    <form method="post" action="{{ path('account_follow_delete', { id: shop.id }) }}" class="follow-card__form">
                        {{ csrf_field('account')|raw }}
                        <button type="submit" class="follow-card__unfollow">
                            {{ translate('Ne plus suivre') }}
                        </button>
                    </form>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="account-empty">
            <p class="account-empty__text">
                {{ translate('Vous ne suivez aucun établissement. Suivez vos adresses préférées depuis leur page pour être prévenu de leurs créneaux.') }}
            </p>
            <a href="{{ path('search_index') }}" class="btn btn--primary btn--small">
                {{ translate('Trouver un établissement') }}
            </a>
        </div>
    {% endif %}
{% endblock %}