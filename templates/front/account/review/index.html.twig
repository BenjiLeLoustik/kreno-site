{% extends 'layouts/account.html.twig' %}

{% set account_section = 'reviews' %}

{% block title %}
    {{ translate('Mes avis · {site}', {site: website().siteName}) }}
{% endblock %}

{% block account_content %}
    <header class="account-head">
        <h1 class="account-head__title">
            {{ translate('Mes avis') }}
        </h1>
        <p class="account-head__subtitle">
            {{ translate('Ton avis aide les autres clients à choisir et les pros à s\'améliorer.') }}
        </p>
    </header>

    <section class="account-section">
        <h2 class="account-section__title">
            {{ translate('À noter') }}
        </h2>
        {% if pending is not empty %}
            <div class="review-pending">
                {% for booking in pending %}
                    <div class="account-card review-pending__item">
                        <span class="review-pending__text">
                            <b>
                                {{ booking.establishment }}
                            </b>
                            <span class="account-card__muted">
                                {% if booking.service %}
                                    {{ booking.service }} ·
                                {% endif %}
                                {{ translate('le {date} à {time}', {
                                    date: booking.startsAt|date('d/m/Y'),
                                    time: booking.startsAt|date('H:i')
                                }) }}
                            </span>
                            <span class="account-card__muted">
                                {{ translate('Avis possible jusqu\'au {deadline}', {deadline: booking.deadline|date('d/m/Y')}) }}
                            </span>
                        </span>
                        <a href="{{ path('account_review_new', { reference: booking.reference }) }}" class="btn btn--primary btn--small">
                            {{ translate('Donner mon avis') }}
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="account-empty">
                <p class="account-empty__text">
                    {{ translate('Rien à noter pour le moment. Après chaque rendez-vous honoré, tu as {windowDays} jours pour donner ton avis.', {windowDays: windowDays}) }}
                </p>
            </div>
        {% endif %}
    </section>

    <section class="account-section">
        <h2 class="account-section__title">
            {{ translate('Mes avis publiés') }}
        </h2>
        {% if reviews is not empty %}
            <ul class="review-list">
                {% for review in reviews %}
                    <li class="account-card review-mine">
                        <div class="review-mine__head">
                            {% if review.visible and review.city and review.slug %}
                                <a href="{{ path('shop_show', { city: review.city, slug: review.slug }) }}#avis" class="review-mine__shop">
                                    {{ review.establishment }}
                                </a>
                            {% else %}
                                <b class="review-mine__shop">
                                    {{ review.establishment }}
                                </b>
                            {% endif %}
                            {% if not review.visible %}
                                <span class="review-status review-status--hidden">
                                    {{ review.statusLabel }}
                                </span>
                            {% endif %}
                        </div>
                        {% include 'front/review/_card.html.twig' with { review: review } only %}
                        {% if not review.visible and review.moderationNote %}
                            <p class="review-mine__note">
                                {{ translate('Motif: {moderationNote}', {moderationNote: review.moderationNote}) }}
                            </p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="account-empty">
                <p class="account-empty__text">
                    {{ translate('Tu n\'as pas encore donné d\'avis.') }}
                </p>
            </div>
        {% endif %}
    </section>
{% endblock %}