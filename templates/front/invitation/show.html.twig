{% extends 'layouts/pro-auth.html.twig' %}

{% block title %}Invitation · {{ website().siteName }} Pro{% endblock %}

{% block javascripts %}
    {% if state == 'signup' %}<script src="{{ asset('js/pages/security/password.js') }}" defer></script>{% endif %}
{% endblock %}

{% block heading %}{{ invitation ? 'Rejoindre ' ~ invitation.company : 'Invitation expirée' }}{% endblock %}

{% block lead %}
    {% if invitation %}
        {{ invitation.invitedBy ? invitation.invitedBy ~ ' vous invite' : 'Vous êtes invité' }} à rejoindre l'espace pro{% if invitation.establishment %} de {{ invitation.establishment }}{% endif %}.
    {% else %}
        {{ error }}
    {% endif %}
{% endblock %}

{% block content %}
    {% if not invitation %}
        <p class="invitation-note">Demandez au responsable de l'établissement de vous renvoyer une invitation depuis son espace Équipe.</p>
        <a href="{{ path('home_index') }}" class="btn btn--outline form-submit">Retour à l'accueil</a>
    {% else %}
        <dl class="invitation-facts">
            <dt class="invitation-facts__label">Entreprise</dt>
            <dd class="invitation-facts__value">{{ invitation.company }}</dd>
            {% if invitation.establishment %}
                <dt class="invitation-facts__label">Établissement</dt>
                <dd class="invitation-facts__value">{{ invitation.establishment }}</dd>
            {% endif %}
            <dt class="invitation-facts__label">Rôle</dt>
            <dd class="invitation-facts__value">{{ invitation.roleLabel }}</dd>
            <dt class="invitation-facts__label">Adresse</dt>
            <dd class="invitation-facts__value">{{ invitation.email }}</dd>
        </dl>

        {% if state == 'ready' %}
            <form method="post" action="{{ path('pro_invitation_accept', { token: token }) }}" class="form">
                {{ csrf_field('invitation')|raw }}
                <button type="submit" class="btn btn--primary form-submit">Rejoindre l'équipe</button>
            </form>
        {% elseif state == 'other' %}
            <div class="form-alert form-alert--error" role="alert">Vous êtes connecté avec {{ loggedInAs }}. Cette invitation est destinée à {{ invitation.email }} : déconnectez-vous puis revenez sur ce lien.</div>
            <form method="post" action="{{ logout_path() }}" class="form">
                <button type="submit" class="btn btn--outline form-submit">Me déconnecter</button>
            </form>
        {% elseif state == 'login' %}
            <p class="invitation-note">Un compte existe déjà avec {{ invitation.email }}. Connectez-vous pour accepter l'invitation.</p>
            <form method="post" action="{{ path('app_login') }}" class="form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <input type="hidden" name="_target_path" value="{{ path('pro_invitation_show', { token: token }) }}">
                <input type="hidden" name="email" value="{{ invitation.email }}">
                <label for="invitation-password" class="form-field">
                    <span class="form-field__head">
                        Mot de passe
                        <a href="{{ path('pro_forgot_password') }}" class="form-field__aside">Mot de passe oublié ?</a>
                    </span>
                    <input id="invitation-password" type="password" name="password" required autocomplete="current-password" class="form-input">
                </label>
                <button type="submit" class="btn btn--primary form-submit">Me connecter</button>
            </form>
        {% else %}
            <form method="post" action="{{ path('pro_invitation_accept', { token: token }) }}" class="form">
                {{ csrf_field('invitation')|raw }}
                <div class="invitation-names">
                    <label for="invitation-first" class="form-field">
                        Prénom
                        <input id="invitation-first" type="text" name="firstName" required maxlength="80" autocomplete="given-name" class="form-input">
                    </label>
                    <label for="invitation-last" class="form-field">
                        Nom
                        <input id="invitation-last" type="text" name="lastName" maxlength="80" autocomplete="family-name" class="form-input">
                    </label>
                </div>
                {% include 'front/security/_password_field.html.twig' with { id: 'invitation-password', name: 'password', label: 'Mot de passe' } %}
                <button type="submit" class="btn btn--primary form-submit">Créer mon accès et rejoindre l'équipe</button>
            </form>
        {% endif %}
    {% endif %}
{% endblock %}