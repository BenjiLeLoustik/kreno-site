{% extends 'layouts/front.html.twig' %}

{% set code = status ~ '' %}

{% block title %}
    {{ error.name }} · {{ website().siteName }}
{% endblock %}

{% block content %}
    <div class="error-page">
        <div class="error-page__ticket">

            {% embed 'components/ticket.html.twig' with {
                day: translate('Erreur {code}', {code: code}),
                time: code|slice(0, 1) ~ ':' ~ code|slice(1),
                duration: error.label,
                modifier: 'large'
            } %}

                {% block ticket_body %}
                    <b class="ticket__name">
                        {{ error.name }}
                    </b>
                    <span class="ticket__what">
                        {{ error.hint }}
                    </span>
                {% endblock %}

            {% endembed %}

        </div>

        <div class="error-page__text">
            <span class="error-page__eyebrow">
                {{ translate('Erreur {code}', {code: code}) }}
            </span>
            <h1 class="error-page__title">
                {{ error.title }}
            </h1>
            <p class="error-page__message">
                {{ error.message }}
            </p>
            <div class="error-page__actions">
                <a href="{{ path('search_index') }}" class="btn btn--primary">
                    {{ translate('Voir les créneaux libres') }}
                </a>
                <a href="{{ path('home_index') }}" class="btn btn--outline">
                    {{ translate('Retour à l\'accueil') }}
                </a>
                {% if error.helpLink %}
                    <a href="{{ path('page_help') }}" class="btn btn--outline">
                        {{ translate('Aide et contact') }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}