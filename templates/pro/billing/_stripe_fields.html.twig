<fieldset class="signup-fieldset stripe-fields">
    <legend class="signup-legend">
        Moyen de paiement
    </legend>
    <div class="signup-choices">
        <label class="signup-choice">
            <input type="radio" name="type" value="card" class="signup-choice__input" checked data-stripe-type>
            <b class="signup-choice__title">
                Carte bancaire
            </b>
            <span class="signup-choice__text">
                Visa, Mastercard, CB
            </span>
        </label>
        <label class="signup-choice">
            <input type="radio" name="type" value="sepa_debit" class="signup-choice__input" data-stripe-type>
            <b class="signup-choice__title">
                Prélèvement SEPA
            </b>
            <span class="signup-choice__text">
                Avec votre IBAN
            </span>
        </label>
    </div>
    <div class="stripe-fields__element" data-stripe-element="card"></div>
    <div class="stripe-fields__element" data-stripe-element="sepa_debit" hidden></div>
    <label class="settings-check" data-stripe-mandate hidden>
        <input type="hidden" name="mandateAccepted" value="0">
        <input type="checkbox" name="mandateAccepted" value="1" class="settings-check__input">
        <span>
            J'autorise {{ website().siteName }} et son prestataire de paiement à envoyer des instructions à ma banque pour débiter mon compte, conformément au mandat SEPA.
        </span>
    </label>
    <input type="hidden" name="setupReference" value="" data-stripe-reference>
    <p class="pro-flash pro-flash--error" data-stripe-error hidden></p>
    <noscript>
        <p class="pro-flash pro-flash--error">
            JavaScript est nécessaire pour enregistrer un moyen de paiement de façon sécurisée.
        </p>
    </noscript>
</fieldset>