{% extends 'layouts/base.html.twig' %}

{% block title %}
    {{ translate('Connexion · Kréno Pro') }}
{% endblock %}

{% block body_class %}layout-auth layout-auth--pro{% endblock %}

{% block body %}
    <div class="pro-login">
        <a href="{{ path('pro_landing') }}" class="pro-login__brand" aria-label="Kréno Pro, accueil">
            {% include 'components/logo.html.twig' with {
                size: 0,
                light: true,
                badge: 'pro'
            } %}
        </a>

        <form method="post" action="{{ path('app_login') }}" class="pro-login__card form">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <input type="hidden" name="_target_path" value="{{ targetPath }}">

            <div class="pro-login__head">
                <h1 class="pro-login__title">
                    {{ translate('Espace professionnel') }}
                </h1>
                <span class="pro-login__lead">
                    {{ translate('Connectez-vous pour publier vos créneaux.') }}
                </span>
            </div>

            {% for type, messages in flashes() %}
                {% for message in messages %}
                    <div class="form-alert form-alert--{{ type == 'success' ? 'success' : 'error' }}" role="status">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% if error %}
                <div class="form-alert form-alert--error" role="alert">
                    {{ error }}
                </div>
            {% endif %}

            <label for="pro-login-email" class="form-field">
                {{ translate('Adresse e-mail professionnelle') }}
                <input id="pro-login-email" type="email" name="email" value="{{ lastUsername }}" required autofocus autocomplete="email" class="form-input">
            </label>
            <label for="pro-login-password" class="form-field">
                <span class="form-field__head">
                    {{ translate('Mot de passe') }}
                    <a href="{{ path('pro_forgot_password') }}" class="form-field__aside">
                        {{ translate('Mot de passe oublié ?') }}
                    </a>
                </span>
                <input id="pro-login-password" type="password" name="password" required autocomplete="current-password" class="form-input">
            </label>
            <label class="form-check">
                <input type="checkbox" name="_remember_me" value="1" class="form-check__input">
                {{ translate('Rester connecté') }}
            </label>
            <button type="submit" class="btn btn--primary form-submit">
                {{ translate('Se connecter') }}
            </button>

            <span class="pro-login__signup">
                {{ translate('Pas encore partenaire ?') }}
                <a href="{{ path('pro_signup') }}" class="pro-login__signup-link">
                    {{ translate('Créer mon espace pro') }}
                </a>
            </span>
        </form>

        <a href="{{ path('app_login') }}" class="pro-login__switch">
            {{ translate('Vous êtes client ? Connexion client') }}
        </a>
    </div>
{% endblock %}