{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'billing' %}

{% block title %}
    {{ translate('Abonnement · Espace pro') }}
{% endblock %}

{% block content %}
    <div class="pro-head">
        <div class="pro-head__text">
            <a href="{{ path('pro_billing') }}" class="pro-back">
                ← {{ translate('Facturation') }}
            </a>
            <h1 class="pro-title">
                {{ translate('Formules') }}
            </h1>
            <span class="pro-subtitle">
                {{ translate('{count, plural, one {# établissement facturable. Le changement vers un abonnement est immédiat, au prorata.} other {# établissements facturables. Le changement vers un abonnement est immédiat, au prorata.}}', { count: establishmentsCount }) }}
            </span>
        </div>
    </div>

    {% if current %}
        <section class="pro-card">
            {% set subscription = current %}
            {% include 'pro/subscription/_summary.html.twig' %}
            <div class="settings-line__actions">
                {% if current.canCancel %}
                    <a href="{{ path('pro_subscription_cancel_form') }}" class="pro-button pro-button--small pro-button--danger">
                        {{ translate('Résilier') }}
                    </a>
                {% endif %}
                {% if current.canRevoke %}
                    <form method="post" action="{{ path('pro_subscription_cancel_revoke') }}">
                        {{ csrf_field('pro')|raw }}
                        <button type="submit" class="pro-button pro-button--small pro-button--success">
                            {{ translate('Annuler la résiliation') }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% include 'components/period_tabs.html.twig' with { route: 'pro_subscription' } %}

    <div class="plan-grid">
        {% for plan in plans %}
            <div class="plan-card{{ plan.current ? ' plan-card--current' : '' }}">
                {% include 'components/plan_card.html.twig' %}
                {% if plan.current %}
                    <span class="plan-card__cta plan-card__cta--muted">
                        {{ translate('Votre formule') }}
                    </span>
                {% else %}
                    <a href="{{ path('pro_subscription_quote', { plan: plan.code, period: period }) }}" class="pro-button pro-button--primary plan-card__cta">
                        {{ translate('Choisir') }}
                    </a>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}