{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'billing' %}

{% block title %}{{ translate('Résilier · Espace pro') }}{% endblock %}

{% block content %}
    <div class="pro-head">
        <div class="pro-head__text">
            <a href="{{ path('pro_subscription') }}" class="pro-back">
                ← {{ translate('Formules') }}
            </a>
            <h1 class="pro-title">
                {{ translate('Résilier « {plan} »', { plan: cancellation.plan }) }}
            </h1>
            <span class="pro-subtitle">
                {{ translate('{company} · votre formule reste active jusqu\'au {date}.', { company: cancellation.company, date: cancellation.activeUntil }) }}
            </span>
        </div>
    </div>

    {% set offers = cancellation.offers|filter(offer => offer) %}
    {% if offers is not empty %}
        <section class="cancel-offers">
            {% for key, offer in offers %}
                <form method="post" action="{{ path('pro_subscription_offer') }}" class="cancel-offer">
                    {{ csrf_field('pro')|raw }}
                    <input type="hidden" name="offer" value="{{ key }}">
                    <b class="cancel-offer__title">
                        {{ offer.title }}
                    </b>
                    <span class="cancel-offer__text">
                        {{ offer.text }}
                    </span>
                    <button type="submit" class="pro-button pro-button--small">
                        {{ offer.cta }}
                    </button>
                </form>
            {% endfor %}
        </section>
    {% endif %}

    <div class="pro-columns">
        <section class="pro-card pro-columns__main">
            <h2 class="pro-card__title">
                {{ translate('Ce qui change') }}
            </h2>
            <dl class="pro-facts">
                <dt class="pro-facts__label">
                    {{ translate('Fin de la formule') }}
                </dt>
                <dd class="pro-facts__value">
                    {{ cancellation.activeUntil }}
                </dd>
                <dt class="pro-facts__label">
                    {{ translate('À partir du') }}
                </dt>
                <dd class="pro-facts__value">
                    {{ cancellation.switchDate }} · {{ cancellation.nextPlan }}
                </dd>
                <dt class="pro-facts__label">
                    {{ translate('Remboursement') }}
                </dt>
                <dd class="pro-facts__value">
                    {{ cancellation.refund }}
                </dd>
            </dl>
            <div class="cancel-lists">
                <div class="cancel-list">
                    <b>
                        {{ translate('Vous gardez') }}
                    </b>
                    <ul class="cancel-list__items">
                        {% for item in cancellation.keep %}
                            <li class="cancel-list__item cancel-list__item--keep">
                                {{ item }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="cancel-list">
                    <b>
                        {{ translate('Vous perdez') }}
                    </b>
                    <ul class="cancel-list__items">
                        {% for item in cancellation.lose %}
                            <li class="cancel-list__item cancel-list__item--lose">
                                {{ item }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </section>

        <section class="pro-card pro-columns__aside">
            <h2 class="pro-card__title">
                {{ translate('Confirmer la résiliation') }}
            </h2>
            <form method="post" action="{{ path('pro_subscription_cancel') }}" class="pro-form">
                {{ csrf_field('pro')|raw }}
                <fieldset class="report-reasons">
                    <legend class="pro-field">
                        {{ translate('Pourquoi partez-vous ?') }}
                    </legend>
                    {% for reason in cancellation.reasons %}
                        <label class="settings-check">
                            <input type="radio" name="reason" value="{{ reason.key }}" class="settings-check__input" required>
                            {{ reason.label }}
                        </label>
                    {% endfor %}
                </fieldset>
                <label class="pro-field">
                    {{ translate('Un commentaire (facultatif)') }}
                    <textarea name="comment" rows="3" maxlength="1000" class="pro-input pro-input--area"></textarea>
                </label>
                <label class="settings-check">
                    <input type="hidden" name="acknowledged" value="0">
                    <input type="checkbox" name="acknowledged" value="1" class="settings-check__input" required>
                    {{ cancellation.acknowledgement }}
                </label>
                <button type="submit" class="pro-button pro-button--danger pro-button--block">
                    {{ translate('Résilier ma formule') }}
                </button>
                <a href="{{ path('pro_subscription') }}" class="pro-button pro-button--block">
                    {{ translate('Garder ma formule') }}
                </a>
            </form>
        </section>
    </div>
{% endblock %}