{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'billing' %}

{% block title %}
    {{ translate('Changer de formule · Espace pro') }}
{% endblock %}

{% block content %}
    <div class="pro-head">
        <div class="pro-head__text">
            <a href="{{ path('pro_subscription', { period: period }) }}" class="pro-back">
                ← {{ translate('Formules') }}
            </a>
            <h1 class="pro-title">
                {{ translate('Passer à « {plan} »', { plan: plan.name }) }}
            </h1>
            {% if current %}
                <span class="pro-subtitle">
                    {{ translate('Aujourd\'hui : {plan} · {price}', { plan: current.plan.name, price: current.priceLine }) }}
                </span>
            {% endif %}
        </div>
    </div>

    <div class="pro-columns">
        <section class="pro-card pro-columns__main">
            <div class="plan-card plan-card--flat">
                {% include 'components/plan_card.html.twig' %}
            </div>

            <dl class="pro-facts">
                <dt class="pro-facts__label">
                    {{ translate('Tarif') }}
                </dt>
                <dd class="pro-facts__value">
                    {{ quote.priceLabel }} {{ quote.unit }} · {{ quote.priceIncludingTaxLabel }}
                    {% if quote.monthlyEquivalent %}
                        · {{ translate('soit {amount}', { amount: quote.monthlyEquivalent }) }}
                    {% endif %}
                </dd>
                {% if not quote.perBooking %}
                    <dt class="pro-facts__label">
                        {{ translate('Première échéance') }}
                    </dt>
                    <dd class="pro-facts__value">
                        {{ quote.firstLabel }}
                    </dd>
                {% endif %}
                {% if prorata %}
                    <dt class="pro-facts__label">
                        {{ translate('Nouvelle période') }}
                    </dt>
                    <dd class="pro-facts__value">
                        {% if quote.perBooking %}
                            —
                        {% else %}
                            {{ translate('jusqu\'au {date}', { date: prorata.until }) }}
                        {% endif %}
                    </dd>
                    <dt class="pro-facts__label">
                        {{ translate('Montant de la formule') }}
                    </dt>
                    <dd class="pro-facts__value">
                        {% if prorata.keepsPeriodEnd %}
                            {{ translate('{amount} TTC (au prorata)', { amount: prorata.charge }) }}
                        {% else %}
                            {{ translate('{amount} TTC', { amount: prorata.charge }) }}
                        {% endif %}
                    </dd>
                    <dt class="pro-facts__label">
                        {{ translate('Crédit non utilisé') }}
                    </dt>
                    <dd class="pro-facts__value">
                        {{ translate('{amount} TTC', { amount: prorata.credit }) }}
                    </dd>
                    <dt class="pro-facts__label">
                        <b>
                            {{ translate('À payer aujourd\'hui') }}
                        </b>
                    </dt>
                    <dd class="pro-facts__value">
                        <b>
                            {{ translate('{amount} TTC', { amount: prorata.due }) }}
                        </b>
                    </dd>
                {% endif %}
            </dl>

            {% if scheduled %}
                <p class="pro-note">
                    {% if current and current.nextDate %}
                        {{ translate('Ce changement prendra effet à la fin de votre période en cours, le {date}. Rien n\'est prélevé aujourd\'hui.', { date: current.nextDate }) }}
                    {% else %}
                        {{ translate('Ce changement prendra effet à la fin de votre période en cours. Rien n\'est prélevé aujourd\'hui.') }}
                    {% endif %}
                </p>
            {% endif %}
            {% if uncoveredEstablishments > 0 %}
                <p class="pro-flash pro-flash--warning">
                    {{ translate('{count, plural, one {# établissement ne sera pas couvert par cette formule et sera facturé à la réservation.} other {# établissements ne seront pas couverts par cette formule et seront facturés à la réservation.}}', { count: uncoveredEstablishments }) }}
                </p>
            {% endif %}

            {% if not quote.perBooking %}
                <form method="get" action="{{ path('pro_subscription_quote') }}" class="settings-inline">
                    <input type="hidden" name="plan" value="{{ plan.code }}">
                    <input type="hidden" name="period" value="{{ period }}">
                    <label class="pro-field settings-inline__grow">
                        {{ translate('Code promo') }}
                        <input type="text" name="promoCode" value="{{ promoCode }}" maxlength="40" class="pro-input" autocomplete="off">
                    </label>
                    <button type="submit" class="pro-button">
                        {{ translate('Appliquer') }}
                    </button>
                </form>
                {% if promo %}
                    <p class="pro-flash pro-flash--success">
                        {{ translate('Code {code} : {label}', { code: promo.code, label: promo.label }) }}
                    </p>
                {% endif %}
                {% if promoError %}
                    <p class="pro-flash pro-flash--error">
                        {{ promoError }}
                    </p>
                {% endif %}
            {% endif %}
        </section>

        <aside class="pro-card pro-columns__aside">
            <h2 class="pro-card__title">
                {{ translate('Confirmer') }}
            </h2>
            <form method="post" action="{{ path('pro_subscription_change') }}" class="pro-form">
                {{ csrf_field('pro')|raw }}
                <input type="hidden" name="plan" value="{{ plan.code }}">
                <input type="hidden" name="period" value="{{ period }}">
                <input type="hidden" name="promoCode" value="{{ promo ? promo.code : '' }}">
                {% if current and not scheduled and not quote.perBooking %}
                    {% if paymentMethods is empty %}
                        <p class="pro-subtitle">
                            {{ translate('Ajoutez d\'abord un moyen de paiement.') }}
                        </p>
                        <a href="{{ path('pro_billing') }}#moyens" class="pro-button">
                            {{ translate('Ajouter un moyen de paiement') }}
                        </a>
                    {% else %}
                        <fieldset class="report-reasons">
                            <legend class="pro-field">
                                {{ translate('Payer avec') }}
                            </legend>
                            {% for method in paymentMethods %}
                                <label class="settings-check">
                                    <input type="radio" name="paymentMethodId" value="{{ method.id }}" class="settings-check__input"{{ method.isDefault ? ' checked' : '' }}>
                                    <span>
                                        {{ method.label }}
                                        <span class="pro-row__meta">
                                            {{ method.note }}
                                        </span>
                                    </span>
                                </label>
                            {% endfor %}
                        </fieldset>
                    {% endif %}
                {% endif %}
                {% if not (current and not scheduled and not quote.perBooking and paymentMethods is empty) %}
                    <button type="submit" class="pro-button pro-button--primary pro-button--block">
                        {% if prorata and not prorata.dueIsZero %}
                            {{ translate('Payer {amount} et changer', { amount: prorata.due }) }}
                        {% else %}
                            {{ translate('Confirmer le changement') }}
                        {% endif %}
                    </button>
                {% endif %}
            </form>
        </aside>
    </div>
{% endblock %}