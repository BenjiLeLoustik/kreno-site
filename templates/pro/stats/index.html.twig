{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'stats' %}

{% block title %}
    {{ translate('Statistiques · Espace pro') }}
{% endblock %}

{% block content %}
    <div class="pro-head">
        <h1 class="pro-title">
            {{ translate('Statistiques') }}
        </h1>
        <nav class="pro-tabs" aria-label="{{ translate('Période') }}">
            {% for period in stats.periods %}
                <a href="{{ path('pro_stats', { period: period.value }) }}" class="pro-tabs__link{{ period.selected ? ' pro-tabs__link--active' : '' }}"{{ period.selected ? ' aria-current="page"' : '' }}>
                    {{ period.label }}
                </a>
            {% endfor %}
        </nav>
    </div>

    <div class="pro-stats">
        {% for kpi in stats.kpis %}
            <div class="pro-stat">
                <span class="pro-stat__label">
                    {{ kpi.label }}
                </span>
                <strong class="pro-stat__value">
                    {{ kpi.value }}
                </strong>
                <span class="pro-stat__note">
                    {{ kpi.note }}
                </span>
            </div>
        {% endfor %}
    </div>

    {% if stats.advanced %}
        <div class="pro-columns">
            <section class="pro-card pro-columns__main">
                <div class="pro-card__head">
                    <h2 class="pro-card__title">
                        {{ translate('Créneaux publiés et réservés') }}
                    </h2>
                    <span class="stats-legend">
                        <span class="stats-legend__dot stats-legend__dot--published"></span>
                        {{ translate('Publiés') }}
                        <span class="stats-legend__dot stats-legend__dot--booked"></span>
                        {{ translate('Réservés') }}
                    </span>
                </div>
                <div class="stats-chart">
                    {% for week in stats.weeks %}
                        <div class="stats-chart__week" title="{{ week.label }} : {{ week.title }}">
                            <div class="stats-chart__bars">
                                <span class="stats-chart__bar stats-chart__bar--published" style="--value: {{ week.publishedPercent }};"></span>
                                <span class="stats-chart__bar stats-chart__bar--booked" style="--value: {{ week.bookedPercent }};"></span>
                            </div>
                            <span class="stats-chart__label">
                                {{ week.label }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="pro-card pro-columns__aside">
                <h2 class="pro-card__title">
                    {{ translate('Prestations les plus réservées') }}
                </h2>
                {% for service in stats.services %}
                    <div class="stats-service">
                        <span class="stats-service__head">
                            <b>
                                {{ service.name }}
                            </b>
                            <span class="pro-row__meta">
                                {{ service.label }}
                            </span>
                        </span>
                        <span class="stats-service__track">
                            <span class="stats-service__fill" style="--value: {{ service.percent }};"></span>
                        </span>
                    </div>
                {% else %}
                    <p class="pro-subtitle">
                        {{ translate('Pas encore de réservation sur la période.') }}
                    </p>
                {% endfor %}
            </section>
        </div>

        {% if stats.heatmap %}
            <section class="pro-card">
                <h2 class="pro-card__title">
                    {{ translate('Rapidité de réservation selon le moment') }}
                </h2>
                <div class="stats-heatmap">
                    <table class="stats-heatmap__table">
                        <thead>
                        <tr>
                            <th scope="col">
                                <span class="sr-only">
                                    {{ translate('Jour') }}
                                </span>
                            </th>
                            {% for hour in stats.heatmap.hours %}
                                <th scope="col" class="stats-heatmap__hour">
                                    {{ hour }}
                                </th>
                            {% endfor %}
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in stats.heatmap.rows %}
                            <tr>
                                <th scope="row" class="stats-heatmap__day">
                                    {{ row.day }}
                                </th>
                                {% for cell in row.cells %}
                                    <td class="stats-heatmap__cell stats-heatmap__cell--{{ cell.level }}" title="{{ cell.title }}"></td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if stats.heatmap.tip %}
                    <div class="pro-note">
                        {{ stats.heatmap.tip }}
                    </div>
                {% endif %}
            </section>
        {% endif %}
    {% else %}
        <div class="pro-empty">
            <i data-lucide="chart-column" class="stats-upsell__icon"></i>
            <b>
                {{ translate('Statistiques détaillées') }}
            </b>
            {{ translate('Évolution semaine par semaine, prestations les plus demandées et meilleurs moments pour publier : inclus dans l\'abonnement.') }}
            {% if route_exists('pro_subscription') and (context.permissions.company['company.billing'] ?? false) %}
                <a href="{{ path('pro_subscription') }}" class="pro-button pro-button--primary">
                    {{ translate('Voir l\'abonnement') }}
                </a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}