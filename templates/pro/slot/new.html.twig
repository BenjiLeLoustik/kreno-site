{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'publish' %}
{% set current = services|filter(service => service.id == prefill.serviceId)|first ?: services|first %}

{% block title %}Publier un créneau · Espace pro{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/pages/pro/slot-new.js') }}" defer></script>
{% endblock %}

{% block content %}
    <div class="pro-head">
        <div class="pro-head__text">
            <h1 class="pro-title">Publier un créneau libéré</h1>
            <span class="pro-subtitle">Il sera visible par les clients du quartier jusqu'à l'heure d'expiration.</span>
        </div>
        <a href="{{ path('pro_slots') }}" class="pro-button">Voir mes créneaux</a>
    </div>

    {% if services is empty %}
        <div class="pro-empty">
            Ajoutez d'abord une prestation : c'est elle qui fixe la durée et le prix habituel du créneau.
            {% if route_exists('pro_services') %}<a href="{{ path('pro_services') }}" class="pro-button pro-button--primary">Ajouter une prestation</a>{% endif %}
        </div>
    {% else %}
        <div class="pro-columns">
            <form method="post" action="{{ path('pro_slot_publish') }}" class="pro-card pro-form pro-columns__main" data-publish-form>
                {{ csrf_field('pro')|raw }}

                <label class="pro-field">
                    Prestation
                    <select name="serviceId" class="pro-input" required data-publish-service>
                        {% for service in services %}
                            <option value="{{ service.id }}" data-price="{{ service.price }}" data-duration="{{ service.durationLabel }}" data-name="{{ service.name }}"{{ service.id == current.id ? ' selected' : '' }}>{{ service.name }} · {{ service.durationLabel }} · {{ service.priceLabel }}</option>
                        {% endfor %}
                    </select>
                </label>

                <div class="pro-form__row">
                    <label class="pro-field">
                        Jour
                        <select name="day" class="pro-input" required data-publish-day>
                            {% for day in days %}
                                <option value="{{ day.value }}"{{ day.value == prefill.day ? ' selected' : '' }}>{{ day.label }} · {{ day.value|date('d/m') }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="pro-field">
                        Heure
                        <input type="time" name="time" value="{{ prefill.time }}" required step="300" class="pro-input" data-publish-time>
                    </label>
                </div>

                <label class="pro-field">
                    <span class="pro-field__head">Remise <b class="publish-discount" data-publish-discount-label>-{{ prefill.discount }} %</b></span>
                    <input type="range" name="discount" min="{{ defaults.minDiscount }}" max="{{ defaults.maxDiscount }}" step="5" value="{{ prefill.discount }}" class="pro-range" data-publish-discount>
                    <span class="pro-field__hint">Entre {{ defaults.minDiscount }} % et {{ defaults.maxDiscount }} %.</span>
                </label>

                <div class="pro-form__row">
                    <label class="pro-field">
                        Retirer le créneau
                        <select name="removalMinutes" class="pro-input" data-publish-removal>
                            {% for minutes in defaults.removalChoices %}
                                <option value="{{ minutes }}"{{ minutes == defaults.removalMinutes ? ' selected' : '' }}>{{ minutes >= 60 ? (minutes // 60) ~ ' h' ~ (minutes % 60 ? ' ' ~ (minutes % 60) ~ ' min' : '') : minutes ~ ' min' }} avant</option>
                            {% endfor %}
                        </select>
                    </label>
                    {% if staff|length > 1 %}
                        <label class="pro-field">
                            Avec
                            <select name="staffId" class="pro-input">
                                <option value="">Peu importe</option>
                                {% for member in staff %}
                                    <option value="{{ member.id }}"{{ member.id == prefill.staffId ? ' selected' : '' }}>{{ member.name }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    {% endif %}
                </div>

                <span class="pro-field__hint">Les clients peuvent réserver jusqu'à {{ defaults.bookingLeadMinutes }} min avant le rendez-vous.</span>

                <button type="submit" class="pro-button pro-button--primary pro-button--block">Mettre en ligne</button>
            </form>

            <aside class="pro-columns__aside publish-preview">
                <span class="publish-preview__label">Aperçu client</span>
                <article class="publish-ticket">
                    <div class="publish-ticket__when">
                        <span class="publish-ticket__day" data-preview-day>{{ (days|filter(day => day.value == prefill.day)|first).label ?? days[0].label }}</span>
                        <strong class="publish-ticket__time" data-preview-time>{{ prefill.time }}</strong>
                        <span class="publish-ticket__duration" data-preview-duration>{{ current.durationLabel }}</span>
                    </div>
                    <div class="publish-ticket__body">
                        <span class="publish-ticket__pro">{{ establishment.name }}</span>
                        <span class="publish-ticket__what"><span data-preview-service>{{ current.name }}</span>{% if establishment.locality %} · {{ establishment.locality }}{% endif %}</span>
                        <span class="publish-ticket__prices">
                            <s class="pro-price__old" data-preview-old>{{ current.priceLabel }}</s>
                            <b class="publish-ticket__price" data-preview-price>—</b>
                            <span class="publish-ticket__badge" data-preview-discount>-{{ prefill.discount }} %</span>
                        </span>
                    </div>
                    <span class="publish-ticket__notch publish-ticket__notch--top"></span>
                    <span class="publish-ticket__notch publish-ticket__notch--bottom"></span>
                </article>
                <p class="pro-subtitle publish-preview__text">Visible jusqu'à <b data-preview-expires>—</b>. Vous gagnez <b data-preview-earn>—</b> au lieu de 0 € sur ce créneau vide.</p>
            </aside>
        </div>
    {% endif %}
{% endblock %}