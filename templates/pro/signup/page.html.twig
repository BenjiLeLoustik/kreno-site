{% extends 'layouts/pro-signup.html.twig' %}

{% block title %}
    {{ translate('Page publique · Inscription pro') }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/pages/pro/signup.js') }}" defer></script>
{% endblock %}

{% block heading %}
    {{ translate('Votre page publique') }}
{% endblock %}

{% block lead %}
    {{ translate('C\'est ce que les clients voient avant de réserver. Vous pourrez compléter plus tard.') }}
{% endblock %}

{% block content %}
    <section class="signup-section" id="photos">
        <div class="signup-section__head">
            <span class="signup-legend">
                {{ translate('Photos') }}
                <span class="pro-field__hint">
                    {{ translate('jusqu\'à {imagesMax}, la première sert de couverture', {imagesMax: page.imagesMax}) }}
                </span>
            </span>
            <span class="pro-field__hint">
                {{ page.images|length }} / {{ page.imagesMax }}
            </span>
        </div>
        <div class="settings-photos">
            {% for image in page.images %}
                <figure class="settings-photo">
                    <img src="{{ image.url }}" alt="{{ image.alt ?: page.preview.name }}" class="settings-photo__image" loading="lazy">
                    {% if image.cover %}
                        <span class="settings-photo__cover">
                            {{ translate('Couverture') }}
                        </span>
                    {% endif %}
                    <figcaption class="settings-photo__actions">
                        <form method="post" action="{{ path('pro_signup_image_delete', { id: image.id }) }}">
                            {{ csrf_field('pro')|raw }}
                            <button type="submit" class="pro-button pro-button--small pro-button--danger" data-pro-confirm="{{ translate('Supprimer cette photo ?') }}">
                                {{ translate('Supprimer') }}
                            </button>
                        </form>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>
        {% if page.images|length < page.imagesMax %}
            <form method="post" action="{{ path('pro_signup_image') }}" enctype="multipart/form-data" class="settings-inline">
                {{ csrf_field('pro')|raw }}
                <label class="pro-field settings-inline__grow">
                    {{ translate('Ajouter une photo') }}
                    <input type="file" name="image" accept="image/jpeg,image/png,image/webp" required class="pro-input settings-file">
                </label>
                <button type="submit" class="pro-button">
                    {{ translate('Envoyer') }}
                </button>
            </form>
            <span class="pro-field__hint">
                {{ translate('Les photos sont enregistrées dès l\'envoi.') }}
            </span>
        {% endif %}
    </section>

    <form method="post" action="{{ path('pro_signup_page') }}" class="signup-form">
        {{ csrf_field('pro')|raw }}
        <label class="pro-field">
            <span class="pro-field__head">
                {{ translate('Présentation') }}
                <span class="pro-field__hint" data-signup-count-output>
                    {{ (page.description ?? '')|length }} / {{ page.descriptionMax }}
                </span>
            </span>
            <textarea name="description" rows="4" maxlength="{{ page.descriptionMax }}" class="pro-input pro-input--area" placeholder="{{ translate('Présentez votre établissement en deux ou trois phrases.') }}" data-signup-count>{{ page.description }}</textarea>
        </label>

        <div class="signup-section">
            <span class="signup-legend">
                {{ translate('Horaires d\'ouverture') }}
            </span>
            <div class="settings-hours">
                {% set row = 0 %}
                {% for day in page.hours %}
                    <div class="settings-hours__day">
                        <b class="settings-hours__name">
                            {{ day.day }}
                        </b>
                        <div class="settings-hours__ranges">
                            {% for index in 0..(rangesPerDay - 1) %}
                                {% set range = day.ranges[index] ?? null %}
                                <span class="settings-hours__range">
                                    <input type="hidden" name="hours[{{ row }}][weekday]" value="{{ day.weekday }}">
                                    <input type="time" name="hours[{{ row }}][opensAt]" value="{{ range ? range.opensAt : '' }}" step="900" class="pro-input settings-hours__time" aria-label="{{ translate('{day}, ouverture {index}', {day: day.day, index: index + 1}) }}">
                                    <span aria-hidden="true">–</span>
                                    <input type="time" name="hours[{{ row }}][closesAt]" value="{{ range ? range.closesAt : '' }}" step="900" class="pro-input settings-hours__time" aria-label="{{ translate('{day}, fermeture {index}', {day: day.day, index: index + 1}) }}">
                                </span>
                                {% set row = row + 1 %}
                            {% endfor %}
                        </div>
                        <span class="settings-hours__label{{ day.closed ? ' settings-hours__label--closed' : '' }}">
                            {{ day.hours }}
                        </span>
                    </div>
                {% endfor %}
            </div>
            <span class="pro-field__hint">
                {{ translate('Laissez vide pour un jour fermé. Deuxième plage pour une pause du midi.') }}
            </span>
        </div>

        {% include 'pro/signup/_actions.html.twig' with { skip: true } %}
    </form>

    <form method="post" action="{{ path('pro_signup_page_skip') }}" id="signup-skip">
        {{ csrf_field('pro')|raw }}
    </form>
{% endblock %}