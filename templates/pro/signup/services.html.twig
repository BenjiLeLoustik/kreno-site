{% extends 'layouts/pro-signup.html.twig' %}

{% macro row(index, service, durations) %}
    <div class="signup-service" data-signup-service>
        <input type="text" name="services[{{ index }}][name]" value="{{ service.name ?? '' }}" maxlength="120" class="pro-input" placeholder="Nom de la prestation" aria-label="Prestation" data-signup-service-name>
        <select name="services[{{ index }}][duration]" class="pro-input" aria-label="Durée" data-signup-service-duration>
            {% for minutes in durations %}
                <option value="{{ minutes }}"{{ minutes == (service.duration ?? 30) ? ' selected' : '' }}>{{ minutes >= 60 ? (minutes // 60) ~ ' h' ~ (minutes % 60 ? ' ' ~ (minutes % 60) : '') : minutes ~ ' min' }}</option>
            {% endfor %}
            {% if service.duration is defined and service.duration not in durations %}
                <option value="{{ service.duration }}" selected>{{ service.durationLabel }}</option>
            {% endif %}
        </select>
        <span class="signup-service__price">
            <input type="text" name="services[{{ index }}][price]" value="{{ service.price is defined ? (service.price / 100)|number_format(2, ',', '') : '' }}" inputmode="decimal" pattern="\d+([.,]\d{1,2})?" class="pro-input" placeholder="38,00" aria-label="Prix habituel en euros" data-signup-service-price>
            <span class="signup-service__unit">€</span>
        </span>
        <button type="button" class="signup-service__remove" aria-label="Retirer la prestation" data-signup-service-remove hidden>×</button>
    </div>
{% endmacro %}

{% block title %}Prestations · Inscription pro{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/pages/pro/signup.js') }}" defer></script>
{% endblock %}

{% block heading %}Ce que vous proposez{% endblock %}

{% block lead %}Ajoutez au moins une prestation avec sa durée et son prix habituel.{% endblock %}

{% block content %}
    {% import _self as ui %}
    {% set rows = services.services %}
    {% set first = rows|first %}

    <form method="post" action="{{ path('pro_signup_services') }}" class="signup-form" data-signup-services>
        {{ csrf_field('pro')|raw }}

        {% if services.suggestions is not empty %}
            <div class="signup-suggestions" data-signup-suggestions hidden>
                <span class="signup-legend">Suggestions{% if services.categoryName %} pour {{ services.categoryName|lower }}{% endif %}</span>
                <div class="signup-chips">
                    {% for suggestion in services.suggestions %}
                        <button type="button" class="signup-chip signup-chip--button" data-signup-suggestion data-name="{{ suggestion.name }}" data-duration="{{ suggestion.duration }}" data-price="{{ (suggestion.price / 100)|number_format(2, ',', '') }}">+ {{ suggestion.name }}</button>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <div class="signup-services">
            <div class="signup-service signup-service--head" aria-hidden="true">
                <span>Prestation</span><span>Durée</span><span>Prix habituel</span><span></span>
            </div>
            <div class="signup-services__rows" data-signup-service-rows>
                {% for service in rows %}
                    {{ ui.row(loop.index0, service, durations) }}
                {% endfor %}
                {% for index in 0..(emptyRows - 1) %}
                    {{ ui.row(rows|length + index, {}, durations) }}
                {% endfor %}
            </div>
            <template data-signup-service-template>{{ ui.row('__index__', {}, durations) }}</template>
            <button type="button" class="signup-services__add" data-signup-service-add hidden>+ Ajouter une prestation</button>
        </div>

        <div class="signup-discount">
            <label class="pro-field" for="signup-discount">
                <span class="pro-field__head">Remise proposée par défaut sur vos créneaux libérés <b class="signup-discount__value" data-signup-discount-value>−{{ services.defaultDiscount }} %</b></span>
                <input id="signup-discount" type="range" name="defaultDiscount" value="{{ services.defaultDiscount }}" min="0" max="90" step="5" class="pro-range" data-signup-discount>
            </label>
            {% if first %}
                <span class="pro-field__hint" data-signup-example data-name="{{ first.name }}" data-price="{{ first.price }}">
                    Exemple : {{ first.name }} à {{ first.priceLabel }} passe à <b data-signup-example-price>{{ services.example.discounted }}</b> pour le client.
                </span>
            {% endif %}
        </div>

        {% include 'pro/signup/_actions.html.twig' %}
    </form>
{% endblock %}