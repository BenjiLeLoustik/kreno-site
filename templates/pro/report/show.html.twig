{% extends 'layouts/pro.html.twig' %}

{% set pro_section = 'reports' %}

{% block title %}
    Signalement {{ report.reference }} · Espace pro
{% endblock %}

{% block content %}
    <div class="pro-head">
        <div class="pro-head__text">
            <a href="{{ path('pro_reports', { tab: received ? 'received' : 'mine' }) }}" class="pro-back">
                ← Signalements · {{ report.reference }}
            </a>
            <h1 class="pro-title">
                {{ report.title }}
            </h1>
        </div>
        <span class="pro-badge{{ report.open ? ' pro-badge--pending' : '' }}">
            {{ report.status }}
        </span>
    </div>

    <div class="pro-columns">
        <section class="pro-card pro-columns__main">
            <p class="report-item__detail">
                {{ report.detail }}
            </p>
            {% if report.booking %}
                <dl class="pro-facts">
                    <dt class="pro-facts__label">
                        Réservation
                    </dt>
                    <dd class="pro-facts__value">
                        {{ report.booking.reference }} · {{ report.booking.label }} · {{ report.booking.price }}
                    </dd>
                </dl>
            {% endif %}
            {% if report.attachment and route_exists('pro_report_attachment') %}
                <a href="{{ path('pro_report_attachment', { id: report.id }) }}" class="pro-button pro-button--small" target="_blank" rel="noopener">
                    <i data-lucide="paperclip" class="pro-nav__icon"></i>
                    {{ report.attachment.name }}
                </a>
            {% endif %}
            {% if report.resolution %}
                <div class="pro-note">
                    <b>
                        Décision :
                    </b>
                    {{ report.resolution }}
                </div>
            {% endif %}

            <h2 class="settings-subtitle">
                Échanges
            </h2>
            {% for message in report.messages %}
                <div class="report-message">
                    <span class="report-message__head">
                        <b>
                            {{ message.author }}
                        </b>
                        {% if message.createdAt %}
                            <span class="pro-row__meta">
                                {{ message.createdAt|date('d/m/Y H:i') }}
                            </span>
                        {% endif %}
                    </span>
                    <p class="report-message__body">
                        {{ message.body|nl2br }}
                    </p>
                </div>
            {% else %}
                <p class="pro-subtitle">
                    Pas encore d'échange.
                </p>
            {% endfor %}
        </section>

        <aside class="pro-card pro-columns__aside">
            {% if received and report.canAnswer %}
                <h2 class="pro-card__title">
                    Votre réponse
                </h2>
                {% if report.replyRemaining %}
                    <p class="pro-subtitle">
                        Réponse attendue sous {{ report.replyRemaining }}. Sans réponse, l'équipe Kréno décide sur la base du signalement.
                    </p>
                {% endif %}
            {% elseif report.open %}
                <h2 class="pro-card__title">
                    Ajouter une précision
                </h2>
            {% else %}
                <h2 class="pro-card__title">
                    Signalement clos
                </h2>
                <p class="pro-subtitle">
                    Ce signalement est traité. Contactez l'équipe Kréno pour toute question.
                </p>
            {% endif %}

            {% if report.open %}
                <form method="post" action="{{ path('pro_report_message', { id: report.id }) }}" class="pro-form">
                    {{ csrf_field('pro')|raw }}
                    <label class="pro-field">
                        Message à l'équipe Kréno
                        <textarea name="body" rows="5" required minlength="2" maxlength="2000" class="pro-input pro-input--area"></textarea>
                    </label>
                    <div>
                        <button type="submit" class="pro-button pro-button--primary">
                            Envoyer
                        </button>
                    </div>
                </form>
            {% endif %}
        </aside>
    </div>
{% endblock %}