{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('Ton compte Kréno est supprimé. Tes réservations à venir ont été annulées et les établissements concernés ont été prévenus.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Tes données personnelles seront effacées dans les délais prévus par notre politique de confidentialité.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Merci d’avoir utilisé {site}. Tu seras toujours le bienvenu : {link}', {
            site: website().siteName,
            link: '<a href="' ~ homeUrl|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">'
            ~ homeUrl|replace({'https://': '', 'http://': ''})|trim('/')|e
            ~ '</a>'
        }, domain: 'email')|raw }}
    </p>

{% endblock %}