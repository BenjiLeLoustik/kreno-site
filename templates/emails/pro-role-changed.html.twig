{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {% if establishment %}
            {{ translate('Votre rôle chez {company} pour {establishment} a changé :', {
                company: company,
                establishment: establishment
            }, domain: 'email') }}
        {% else %}
            {{ translate('Votre rôle chez {company} a changé :', {company: company}, domain: 'email') }}
        {% endif %}

    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Avant :', domain: 'email') }} {{ previousRole }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Maintenant :', domain: 'email') }} {{ newRole }}
        </li>
    </ul>
    <p>
        {{ translate('Vos accès sont mis à jour dès maintenant.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            {{ translate('Ouvrir Kréno Pro', domain: 'email') }}
        </a>
    </p>

{% endblock %}