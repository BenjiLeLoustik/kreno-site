{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Votre signalement {reference} a bien été transmis à l\'équipe Kréno', {reference: report.reference}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Motif :', domain: 'email') }} {{ report.reason }}
        </li>
        {% if report.booking %}
            <li style="{{ styles.item }}">
                {{ translate('Rendez-vous : {service}, {day} à {time} ({customerName})', {
                    service: report.booking.service,
                    day: report.booking.day,
                    time: report.booking.time,
                    customerName: report.booking.customer.name
                }, domain: 'email') }}
            </li>
        {% endif %}
    </ul>
    <p>
        {{ translate('Nous l\'examinons et vous tiendrons informé de notre décision.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ report.proUrl }}" style="{{ styles.button }}">
            {{ translate('Suivre le signalement', domain: 'email') }}
        </a>
        <a href="{{ reportsUrl }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Tous mes signalements', domain: 'email') }}
        </a>
    </p>

{% endblock %}