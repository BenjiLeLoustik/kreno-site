{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('La résiliation de votre abonnement {plan} pour {company} est enregistrée.', {
            plan: subscription.plan,
            company: company
        }, domain: 'email') }}
    </p>
    {% if subscription.cancelAt %}
        <p>
            {{ translate('Votre abonnement reste actif jusqu\'au {cancelAt}. Vous pouvez publier des créneaux jusqu\'à cette date; Aucun prélèvement ne sera effectué ensuite.', {
                cancelAt: subscription.cancelAt
            }, domain: 'email') }}
        </p>
    {% endif %}
    {% if reason %}
        <p>
            {{ translate('Motif indiqué :', domain: 'email') }} {{ reason }}
        </p>
    {% endif %}
    <p>
        {{ translate('Vous changez d’avis ? Vous pouvez annuler la résiliation à tout moment avant cette date.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ subscription.url }}" style="{{ styles.button }}">
            {{ translate('Mon abonnement', domain: 'email') }}
        </a>
    </p>

{% endblock %}