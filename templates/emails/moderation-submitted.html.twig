{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'moderation' %}

{% block mailContent %}

    <p>
        {{ translate('Un nouvel établissement attend sa validation :', domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Nom :', domain: 'email') }} {{ establishment.name }} (#{{ establishment.id }})
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Entreprise :', domain: 'email') }} {{ establishment.company }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('SIRET :', domain: 'email') }} {{ establishment.siret }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Catégorie :', domain: 'email') }} {{ establishment.category }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Adresse :', domain: 'email') }} {{ establishment.address }}
        </li>
        {% if establishment.phone %}
            <li style="{{ styles.item }}">
                {{ translate('Téléphone :', domain: 'email') }} {{ establishment.phone }}
            </li>
        {% endif %}
    </ul>
    <p>
        {{ translate('À traiter dans l’admin, section « Modération des pros ».', domain: 'email') }}
    </p>

{% endblock %}