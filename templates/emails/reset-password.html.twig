{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        Tu as demandé à réinitialiser ton mot de passe Kréno.
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ resetUrl }}" style="{{ styles.button }}">
            Choisir un nouveau mot de passe
        </a>
    </p>
    <p>
        Ce lien est valable {{ expiresIn }}. Si tu n’es pas à l’origine de cette demande, ignore simplement cet e-mail : ton mot de passe reste inchangé .
    </p>

{% endblock %}