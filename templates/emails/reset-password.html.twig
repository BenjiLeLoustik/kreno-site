{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('Tu as demandé à réinitialiser ton mot de passe Kréno.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ resetUrl }}" style="{{ styles.button }}">
            {{ translate('Choisir un nouveau mot de passe', domain: 'email') }}
        </a>
    </p>
    <p>
        {{ translate('Ce lien est valable {expiresIn}. Si tu n\'es pas à l’origine de cette demande, ignore simplement cet e-mail : ton mot de passe reste inchangé.', {expiresIn: expiresIn}, domain: 'email') }}
    </p>

{% endblock %}