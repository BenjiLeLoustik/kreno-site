{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        Merci ! L’inscription de {{ establishment.name }} est complète.
        {{ translate('Merci ! L\'inscription de {name} est complète', {name: establishment.name}, domain: 'email') }}
    </p>
    <p>
        {{ translate('Notre équipe vérifie vos informations (SIRET, adresse, prestations) sous {delay}. Vous receverez un e-mail dès que votre établissement sera en ligne.', {
            delay: delay
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('En attendant, vous pouvez compléter votre page : photos, horaires, description.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            {{ translate('Ouvrir Kréno Pro', domain: 'email') }}
        </a>
    </p>

{% endblock %}