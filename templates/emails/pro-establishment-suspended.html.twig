{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('{name} est suspendu sur Kréno.', {
            name: establishment.name
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Motif :', domain: 'email') }} {{ reason }}
    </p>
    <p>
        {{ translate('Pendant la suspension, votre page n’est plus visible et vous ne pouvez plus publier de créneaux. Les réservations déjà confirmées sont maintenues.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Pour échanger avec notre équipe, écrivez-nous à {supportEmail}.', {
            supportEmail: supportEmail
        }, domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            {{ translate('Ouvrir Kréno Pro', domain: 'email') }}
        </a>
    </p>

{% endblock %}