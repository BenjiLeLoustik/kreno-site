{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Paiement reçu, merci ! La facture n°{number} est réglée.', {number: invoice.number}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Montant : {amount} TTC', {amount: amount}, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Date :', domain: 'email') }} {{ paidAt }}
        </li>
        {% if paymentMethod %}
            <li style="{{ styles.item }}">
                {{ translate('Moyen de paiement :', domain: 'email') }} {{ paymentMethod.label }}
            </li>
        {% endif %}
    </ul>
    {% if subscription %}
        <p>
            {% if subscription.periodEnd %}
                {{ translate('Votre abonnement {plan} est à jour, prochaine échéance le {date}.', {
                    plan: subscription.plan,
                    date: subscription.periodEnd
                }, 'email') }}
            {% else %}
                {{ translate('Votre abonnement {plan} est à jour.', {plan: subscription.plan}, 'email') }}
            {% endif %}
        </p>
    {% endif %}
    <p style="{{ styles.actions }}">
        <a href="{{ invoice.url }}" style="{{ styles.button }}">
            {{ translate('Voir la facture', domain: 'email') }}
        </a>
    </p>

{% endblock %}