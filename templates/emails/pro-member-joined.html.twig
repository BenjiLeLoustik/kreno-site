{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ member }} ({{ email }}) a accepté son invitation et rejoint {{ company }} sur Kréno Pro en tant que {{ role|lower }}.
    </p>
    <p>
        Vous pouvez modifier son rôle ou retirer son accès à tout moment depuis la gestion de l’équipe.
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            Ouvrir Kréno Pro
        </a>
    </p>

{% endblock %}