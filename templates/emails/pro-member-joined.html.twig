{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('{member} ({email}) a accepté son invitation et rejoint {company} sur Kréno Pro en tant que {role}', {
            member: member,
            email: email,
            company: company,
            role: role|lower
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Vous pouvez modifier son rôle ou retirer son accès à tout moment depuis la gestion de l’équipe.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            {{ translate('Ouvrir Kréno Pro', domain: 'email') }}
        </a>
    </p>

{% endblock %}