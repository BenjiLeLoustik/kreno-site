{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Votre accès à {company} sur Kréno Pro a été retiré par un administrateur de l\'entreprise.', {
            company: company
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Vous ne pouvez plus consulter ni gérer ses créneaux et réservations. Votre compte personnel reste actif.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Vous pensez qu’il s’agit d’une erreur ? Rapprochez-vous de l’entreprise ou écrivez-nous à {supportEmail}', {
            supportEmail: supportEmail
        }, domain: 'email') }}
    </p>

{% endblock %}