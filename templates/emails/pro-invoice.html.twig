{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {% if invoice.month %}
            {{ translate('Votre facture {site} Pro de {month} est disponible.', {
                site: website().siteName,
                month: invoice.month
            }, 'email') }}
        {% else %}
            {{ translate('Votre facture {site} Pro est disponible.', {site: website().siteName}, 'email') }}
        {% endif %}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Facture n°{number} du {issuedAt}', {
                number: invoice.number,
                issuedAt: invoice.issuedAt
            }, domain: 'email') }}
        </li>
        {% if invoice.period %}
            <li style="{{ styles.item }}">
                {{ translate('Période :', domain: 'email') }} {{ invoice.period }}
            </li>
        {% endif %}
    </ul>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ styles.table }}">
        {% for line in invoice.lines %}
            <tr>
                <td style="{{ styles.cell }}">
                    {{ line.label }}
                    {% if line.quantity > 1 %}
                        × {{ line.quantity }}
                    {% endif %}
                </td>
                <td style="{{ styles.cellValue }}">
                    {{ line.amount }}
                </td>
            </tr>
        {% endfor %}
        <tr>
            <td style="{{ styles.cell }}">
                {{ translate('Total HT', domain: 'email') }}
            </td>
            <td style="{{ styles.cellValue }}">
                {{ invoice.totalExcludingTax }}
            </td>
        </tr>
        <tr>
            <td style="{{ styles.cell }}">
                {{ translate('TVA', domain: 'email') }}
            </td>
            <td style="{{ styles.cellValue }}">
                {{ invoice.tax }}
            </td>
        </tr>
        <tr>
            <td style="{{ styles.total }}">
                {{ translate('Total TTC', domain: 'email') }}
            </td>
            <td style="{{ styles.totalValue }}">
                {{ invoice.total }}
            </td>
        </tr>
    </table>
    {% if paymentMethod %}
        <p>
            {{ translate('Réglée le {paidAt} par {paymentMethod}.', {
                paidAt: paidAt,
                paymentMethod: paymentMethod.label
            }, domain: 'email') }}
        </p>
    {% else %}
        <p>
            {{ translate('Aucun montant n’est à régler.', domain: 'email') }}
        </p>
    {% endif %}
    <p style="{{ styles.actions }}">
        <a href="{{ invoice.url }}" style="{{ styles.button }}">
            {{ translate('Voir la facture', domain: 'email') }}
        </a>
    </p>

{% endblock %}