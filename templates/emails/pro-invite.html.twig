{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('{inviter} vos invite à rejoindre {target} sur Kréno Pro en tant que {role}', {
            inviter: inviter,
            target: target,
            role: role|lower
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Kréno Pro permet de publier les créneaux libérés de l\'établissement et de suivre les réservations des clients.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ acceptUrl }}" style="{{ styles.button }}">
            {{ translate('Accepter l’invitation', domain: 'email') }}
        </a>
    </p>
    {% if expiresAt %}
        <p>
            {{ translate('Cette invitation est valable jusqu\'au {expiresAt}.', {
                expiresAt: expiresAt
            }, domain: 'email') }}
        </p>
    {% endif %}
    <p>
        {{ translate('Vous ne connaissez pas {inviter} ? Ignoez simplement cet e-mail.', {
            inviter: inviter
        }, domain: 'email') }}
    </p>

{% endblock %}