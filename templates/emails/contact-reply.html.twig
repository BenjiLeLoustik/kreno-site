{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block preheader %}
    {{ translate('L\'équipe Kréno a répondu à ta demande « {topic} ».', {topic: topic}, domain: 'email') }}
{% endblock %}

{% block mailContent %}

    <p>
        {% if reference %}
            {{ translate('L’équipe {site} a répondu à ta demande « {topic} » concernant la réservation {reference} :', {
                site: website().siteName,
                topic: topic|e,
                reference: '<strong style="' ~ styles.strong|e('html_attr') ~ '">' ~ reference|e ~ '</strong>'
            }, domain: 'email')|raw }}
        {% else %}
            {{ translate('L’équipe {site} a répondu à ta demande « {topic} » :', {
                site: website().siteName,
                topic: topic
            }, domain: 'email') }}
        {% endif %}
    </p>

    <blockquote style="{{ styles.quote }}">
        {{ reply|nl2br }}
    </blockquote>

    <p style="{{ styles.actions }}">
        <a href="{{ url }}" style="{{ styles.button }}">
            {{ translate('Voir la conversation et répondre', domain: 'email') }}
        </a>
    </p>

    {% if original %}
        <p style="margin: 24px 0 8px; font-size: 13px; color: #6A6F8C;">
            {{ translate('Ton message :', domain: 'email') }}
        </p>
        <blockquote style="{{ styles.quote }}">
            {{ original|nl2br }}
        </blockquote>
    {% endif %}

    <p>
        {{ translate('Pour nous répondre, utilise le bouton ci-dessus : ta réponse arrivera directement dans ta demande.', domain: 'email') }}
    </p>

{% endblock %}