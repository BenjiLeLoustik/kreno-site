{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Un nouveau moyen de paiement a été enregistré sur votre compte Kréno Pro :', domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ paymentMethod.label }}
            {% if paymentMethod.expiry %}
                {{ translate('(expire {expiry})', {expiry: paymentMethod.expiry}, domain: 'email') }}
            {% endif %}
        </li>
        {% if addedBy %}
            <li style="{{ styles.item }}">
                {{ translate('Ajouté par {by} le {addedAt}', {
                    by: addedBy,
                    addedAt: addedAt
                }, domain: 'email') }}
            </li>
        {% endif %}
        {% if default %}
            <li style="{{ styles.item }}">
                {{ translate('Il sera utilisé pour vos prochains prélèvements.', domain: 'email') }}
            </li>
        {% endif %}
    </ul>
    <p>
        {{ translate('Si vous n\'êtes pas à l\'origine de cet ajout, contactez-nous en répondant à cet e-mail.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ billingUrl }}" style="{{ styles.button }}">
            {{ translate('Facturation', domain: 'email') }}
        </a>
    </p>

{% endblock %}