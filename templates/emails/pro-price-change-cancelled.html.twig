{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Nous vous avions annoncé que le prix de votre abonnement {plan} passerait à {price} HT à partir du {effectiveAt}', {
            plan: subscription.plan,
            price: announcedPrice,
            effectiveAt: effectiveAt
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Ce changement est annulé : votre abonnement reste à {price} HT ({period})', {
            price: subscription.price,
            period: subscription.period|lower
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Vous n’avez rien à faire.', domain: 'email') }}
    </p>
    <p>
        <a href="{{ subscription.url }}">
            {{ translate('Mon abonnement', domain: 'email') }}
        </a>
    </p>

{% endblock %}
