{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('{name} nous a signalé ton absence au rendez-vous suivant :', {name: booking.establishment.name}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ booking.service }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('{day} à {time}', {day: booking.day, time: booking.time}, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Référence :', domain: 'email') }} {{ booking.reference }}
        </li>
    </ul>
    <p>
        {{ translate('Les créneaux Kréno sont libérés à la dernière minute : une absence fait perdre ce créneau à l\'établissement et aux autres clients.', domain: 'email') }}
    </p>
    {% if suspended %}
        <p>
            {% if suspendedUntil %}
                {{ translate('Comme ce n’est pas la première fois, ton compte est suspendu jusqu’au {date}. Tu ne peux pas réserver pendant cette période.', {
                    date: suspendedUntil
                }, domain: 'email') }}
            {% else %}
                {{ translate('Comme ce n’est pas la première fois, ton compte est suspendu. Tu ne peux pas réserver pendant cette période.', domain: 'email') }}
            {% endif %}
        </p>
    {% else %}
        <p>
            {{ translate('Attention : en cas de nouvelle absence, ton compte pourra être suspendu.', domain: 'email') }}
        </p>
    {% endif %}
    <p>
        {{ translate('Tu étais bien présent ou tu avais prévenu ? Tu peux contester depuis {open}tes signalements{close} ou nous écrire à {email}.', {
            open: '<a href="' ~ reportsUrl|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">',
            close: '</a>',
            email: supportEmail|e
        }, domain: 'email')|raw }}
    </p>

{% endblock %}