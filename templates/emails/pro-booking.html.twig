{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Votre créneau a trouvé preneur !', domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ booking.service }} ({{ booking.duration }})
        </li>
        <li style="{{ styles.item }}">
            {{ translate('{day} à {time}', {
                day: booking.day,
                time: booking.time
            }, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Client :', domain: 'email') }} {{ booking.customer.name }}
            {% if booking.customer.phone %}
                · {{ booking.customer.phone }}
            {% endif %}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Prix : {price} (au lieu de {originalPrice}), réglé sur place', {
                price: booking.price,
                originalPrice: booking.originalPrice
            }, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Référence :', domain: 'email') }} {{ booking.reference }}
        </li>
    </ul>
    {% if booking.note %}
        <p>
            {{ translate('Note du client :', domain: 'email') }} « {{ booking.note }} »
        </p>
    {% endif %}
    <p>
        {{ translate('Après le rendez-vous, pensez à indiquer s’il a été honoré.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ booking.proUrl }}" style="{{ styles.button }}">
            {{ translate('Voir la réservation', domain: 'email') }}
        </a>
        <a href="{{ bookingsUrl }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Toutes les réservations', domain: 'email') }}
        </a>
    </p>

{% endblock %}