{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('Petit rappel : ton rendez-vous, c’est dans une heure.', domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ booking.service }} ({{ booking.duration }})
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Aujourd\'hui à {time}', {time: booking.time}, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ booking.establishment.name }}, {{ booking.establishment.address }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('{price}, à réfler sur place', {price: booking.price}, domain: 'email') }}
        </li>
    </ul>
    {% if canCancel %}
        <p>
            {{ translate('Un empêchement ? Tu peux encore annuler gratuitement depuis {open}ta réservation{close}.', {
                open: '<a href="' ~ booking.url|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">',
                close: '</a>'
            }, domain: 'email')|raw }}
        </p>
    {% else %}
        <p>
            {% if booking.establishment.phone %}
                {{ translate('Un empêchement ? Préviens l’établissement au {phone}. Une absence non prévenue peut entraîner la suspension de ton compte.', {
                    phone: booking.establishment.phone
                }, domain: 'email') }}
            {% else %}
                {{ translate('Un empêchement ? Préviens l’établissement. Une absence non prévenue peut entraîner la suspension de ton compte.', domain: 'email') }}
            {% endif %}
        </p>
    {% endif %}

{% endblock %}