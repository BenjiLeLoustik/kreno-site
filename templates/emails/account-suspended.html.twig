{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {% if until %}
            {{ translate('Ton compte {site} est suspendu jusqu’au {date}.', {
                site: website().siteName,
                date: until
            }, domain: 'email') }}
        {% else %}
            {{ translate('Ton compte {site} est suspendu.', {site: website().siteName}, domain: 'email') }}
        {% endif %}
    </p>
    <p>
        {{ translate('Motif :', domain: 'email') }} {{ reason }}
    </p>
    {% if automatic %}
        <p>
            {{ translate('Cette suspension est automatique : elle s’applique selon les règles de la plateforme, notamment en cas d’absences répétées à des rendez-vous.', domain: 'email') }}
        </p>
    {% endif %}
    <p>
        {{ translate('Pendant cette période, tu ne peux pas réserver de nouveau créneau. Tes réservations passées restent consultables.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Tu penses qu\'il s\'agit d\'une erreur ? Écris-nous à {supportEmail}.', {supportEmail: supportEmail}, domain: 'email') }}
    </p>

{% endblock %}