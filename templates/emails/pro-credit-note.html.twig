{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Un avoir a été émis sur votre compte Kréno Pro.', domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            Avoir n° {{ invoice.number }} du {{ invoice.issuedAt }}
            {{ translate('Avoir n°{number} du {issuedAt}', {
                number: invoice.number,
                issuedAt: invoice.issuedAt
            }, domain: 'email') }}
        </li>
        {% if credited %}
            <li style="{{ styles.item }}">
                {{ translate('Sur la facture n°{credited}', {credited: credited}, domain: 'email') }}
            </li>
        {% endif %}
    </ul>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ styles.table }}">
        {% for line in invoice.lines %}
            <tr>
                <td style="{{ styles.cell }}">
                    {{ line.label }}
                </td>
                <td style="{{ styles.cellValue }}">
                    {{ line.amount }}
                </td>
            </tr>
        {% endfor %}
        <tr>
            <td style="{{ styles.total }}">
                {{ translate('Total TTC', domain: 'email') }}
            </td>
            <td style="{{ styles.totalValue }}">
                {{ invoice.total }}
            </td>
        </tr>
    </table>
    <p>
        {{ translate('Ce montant sera déduit de vos prochaines factures ou remboursé sur votre moyen de paiement.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ invoice.url }}" style="{{ styles.button }}">
            {{ translate('Voir l’avoir', domain: 'email') }}
        </a>
    </p>

{% endblock %}