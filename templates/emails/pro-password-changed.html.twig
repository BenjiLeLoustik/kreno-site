{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Le mot de passe de votre compte Kréno a été modifié le {changedAt}.', {changedAt: changedAt}, domain: 'email') }}
    </p>
    <p>
        {{ translate('Si vous êtes à l’origine de ce changement, vous n’avez rien à faire.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Sinon, {open}réinitialisez votre mot de passe{close} immédiatement et contactez-nous à {email}.', {
            open: '<a href="' ~ forgotUrl|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">',
            close: '</a>',
            email: supportEmail|e
        }, domain: 'email')|raw }}
    </p>

{% endblock %}