{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Bonne nouvelle : {name} est validé et en ligne sur Kréno.', {name: establishment.name}, domain: 'email') }}
    </p>
    <p>
        {{ translate('Les clients de {city} peuvent désormais vous trouver et vous suivre. Publiez votre premier créneau libéré pour recevoir vos premières réservations.', {
            city: establishment.city
        }, domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ slotUrl }}" style="{{ styles.button }}">
            {{ translate('Publier un créneau', domain: 'email') }}
        </a>
    </p>
    <p>
        Votre page publique :
        <a href="{{ establishment.url }}" style="{{ styles.link }}">
            {{ establishment.url }}
        </a>
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ dashboardUrl }}" style="{{ styles.button }}">
            {{ translate('Ouvrir Kréno Pro', domain: 'email') }}
        </a>
    </p>

{% endblock %}