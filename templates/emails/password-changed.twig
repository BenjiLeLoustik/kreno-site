{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('Le mot de passe de ton compte Kréno a été modifié le {changedAt}.', {changedAt: changedAt}, domain: 'email') }}
    </p>
    <p>
        {{ translate('C’est bien toi ? Alors tout est en ordre.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Si ce n’est pas toi, {open}réinitialise ton mot de passe{close} tout de suite et écris-nous à {email}.', {
            open: '<a href="' ~ forgotUrl|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">',
            close: '</a>',
            email: supportEmail|e
        }, domain: 'email')|raw }}
    </p>

{% endblock %}