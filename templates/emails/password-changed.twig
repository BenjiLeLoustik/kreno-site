{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        Le mot de passe de ton compte Kréno a été modifié le {{ changedAt }}.
    </p>
    <p>
        C’est bien toi ? Alors tout est en ordre.
    </p>
    <p>
        Si ce n’est pas toi,
        <a href="{{ forgotUrl }}" style="{{ styles.link }}">
            réinitialise ton mot de passe
        </a>
        tout de suite et écris-nous à {{ supportEmail }}.
    </p>

{% endblock %}