{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Malgré nos relances, un paiement de votre abonnement {plan} reste impayé. Les créneaux de {company} ne sont plus publiés sur Kréno.', {
            plan: subscription.plan,
            company: company,
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Réglez la facture en attente pour retrouver immédiatement l\'accès à la publication. Vous pouvez aussi mettre à jour votre moyen de paiement.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ billingUrl }}" style="{{ styles.button }}">
            {{ translate('Régulariser ma situation', domain: 'email') }}
        </a>
    </p>

{% endblock %}