{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Le client a ajouté un message au signalement {reference} :', {
            reference: report.reference
        }, domain: 'email') }}
    </p>
    <blockquote style="{{ styles.quote }}">
        {{ message|nl2br }}
    </blockquote>
    <p style="{{ styles.actions }}">
        <a href="{{ report.proUrl }}" style="{{ styles.button }}">
            {{ translate('Répondre ou voir l\'échange', domain: 'email') }}
        </a>
    </p>

{% endblock %}