{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Vous avez demandé à réinitialiser votre mot de passe Kréno Pro.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ resetUrl }}" style="{{ styles.button }}">
            {{ translate('Choisir un nouveau mot de passe', domain: 'email') }}
        </a>
    </p>
    <p>
        {{ translate('Ce lien est valide {expiresIn}. Si vous n\'êtes pas à l\'origine de cette demande, ignoez cet e-mail : votre mot de passe reste inchangé.', {
            expiresIn: expiresIn
        }, domain: 'email') }}
    </p>

{% endblock %}