{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        Votre nouvelle formule est active pour {{ company }}.
        {{ translate('Votre nouvelle formule est active pour {company}', {company: company}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        {% if previous %}
            <li style="{{ styles.item }}">
                {{ translate('Ancienne formule : {plan} ({price} HT, {period})', {
                    plan: previous.plan,
                    price: previous.price,
                    period: previous.period|lower
                }, domain: 'email') }}
            </li>
        {% endif %}
        <li style="{{ styles.item }}">
            {{ translate('Nouvelle formule : {plan} ({price} HT, {period})', {
                plan: subscription.plan,
                price: subscription.price,
                period: subscription.period|lower
            }, domain: 'email') }}
        </li>
        {% if subscription.periodEnd %}
            <li style="{{ styles.item }}">
                {{ translate('Prochaine échéance :', domain: 'email') }} {{ subscription.periodEnd }}
            </li>
        {% endif %}
    </ul>
    {% if changedBy %}
        <p>
            {{ translate('Changement effectué par {changedBy}.', {changedBy: changedBy}, domain: 'email') }}
        </p>
    {% endif %}
    <p>
        {{ translate('Un éventuel ajustement au prorata apparaîtra sur votre prochaine facture.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ subscription.url }}" style="{{ styles.button }}">
            {{ translate('Mon abonnement', domain: 'email') }}
        </a>
        <a href="{{ billingUrl }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Facturation', domain: 'email') }}
        </a>
    </p>

{% endblock %}