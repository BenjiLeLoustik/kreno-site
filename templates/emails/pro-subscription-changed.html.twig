{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>Votre nouvelle formule est active pour {{ company }}.</p>
    <ul style="{{ styles.list }}">
        {% if previous %}
            <li style="{{ styles.item }}">Ancienne formule : {{ previous.plan }} ({{ previous.price }} HT, {{ previous.period|lower }})</li>
        {% endif %}
        <li style="{{ styles.item }}">Nouvelle formule : {{ subscription.plan }} ({{ subscription.price }} HT, {{ subscription.period|lower }})</li>
        {% if subscription.periodEnd %}
            <li style="{{ styles.item }}">Prochaine échéance : {{ subscription.periodEnd }}</li>
        {% endif %}
    </ul>
    {% if changedBy %}
        <p>Changement effectué par {{ changedBy }}.</p>
    {% endif %}
    <p>Un éventuel ajustement au prorata apparaîtra sur votre prochaine facture.</p>
    <p style="{{ styles.actions }}"><a href="{{ subscription.url }}" style="{{ styles.button }}">Mon abonnement</a><a href="{{ billingUrl }}" style="{{ styles.buttonSecondary }}">Facturation</a></p>

{% endblock %}