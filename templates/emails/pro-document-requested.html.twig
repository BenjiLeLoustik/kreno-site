{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Pour finaliser la vérification de {name}, nous avons besoin d\'un justificatif.', {
            name: establishment.name
        }, domain: 'email') }}
    </p>
    <blockquote style="{{ styles.quote }}">
        {{ message|nl2br }}
    </blockquote>
    <p>
        {{ translate('Répondez simplement à cet e-mail en joignant le document, ou envoyez-le à {replyEmail}', {
            replyEmail: replyEmail
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Votre établissement sera mis en ligne dès réception et vérification.', domain: 'email') }}
    </p>

{% endblock %}