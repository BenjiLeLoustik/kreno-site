{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>Nous avons bien reçu ton signalement {{ report.reference }}.</p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">Motif : {{ report.reason }}</li>
        <li style="{{ styles.item }}">Établissement : {{ report.establishment.name }}</li>
        {% if report.booking %}
            <li style="{{ styles.item }}">Rendez-vous : {{ report.booking.service }}, {{ report.booking.day }} à {{ report.booking.time }}</li>
        {% endif %}
    </ul>
    <p>L’établissement a 72 h pour te répondre. Notre équipe suit l’échange et prendra une décision si besoin. Tu seras prévenu par e-mail à chaque étape.</p>
    <p style="{{ styles.actions }}"><a href="{{ report.url }}" style="{{ styles.button }}">Suivre mon signalement</a></p>

{% endblock %}