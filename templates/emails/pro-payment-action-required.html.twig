{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Votre banque demande une confirmation pour le paiement de la facture n°{number} ({amount}) TTC', {
            number: invoice.number,
            amount: amount
        }, domain: 'email') }}
    </p>
    <p>
        {{ translate('Sans cette confirmation, le paiement ne peut pas aboutir.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ paymentUrl }}" style="{{ styles.button }}">
            {{ translate('Confirmer le paiement', domain: 'email') }}
        </a>
    </p>

{% endblock %}