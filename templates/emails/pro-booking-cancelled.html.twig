{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('{customerName} a annulé son rendez-vous :', {customerName: booking.customer.name}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ booking.service }}
        </li>
        <li style="{{ styles.item }}">
            {{ booking.day }} à {{ booking.time }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Référence :', domain: 'email') }} {{ booking.reference }}
        </li>
    </ul>
    {% if booking.cancellationReason %}
        <p>
            {{ translate('Motif indiqué : « {cancellationReason} »', {
                cancellationReason: booking.cancellationReason
            }, domain: 'email') }}
        </p>
    {% endif %}
    {% if slotReleased %}
        <p>
            {{ translate('Le créneau est automatiquement remis en ligne : il peut encore trouver preneur.', domain: 'email') }}
        </p>
    {% else %}
        <p>
            {{ translate('Le créneau n’a pas pu être remis en ligne (trop proche de l’heure du rendez-vous). Vous pouvez en {open}publier un nouveau{close}.', {
                open: '<a href="' ~ slotUrl|e('html_attr') ~ '" style="' ~ styles.link|e('html_attr') ~ '">',
                close: '</a>'
            }, domain: 'email')|raw }}
        </p>
    {% endif %}
    <p style="{{ styles.actions }}">
        <a href="{{ bookingsUrl }}" style="{{ styles.button }}">
            {{ translate('Voir les réservations', domain: 'email') }}
        </a>
    </p>

{% endblock %}