{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'default' %}

{% block mailContent %}

    <p>
        {{ translate('Bienvenue sur Kréno ! Tu peux désormais réserver en quelques secondes les créneaux libérés par les établissements près de chez toi, à prix réduit.', domain: 'email') }}
    </p>
    <p>
        {{ translate('Pour activer ton compte, confirme ton adresse e-mail :', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ verifyUrl }}" style="{{ styles.button }}">
            {{ translate('Confirmer mon adresse e-mail', domain: 'email') }}
        </a>
    </p>
    <p>
        {{ translate('Ce lien est valable {expiresIn}', {expiresIn: expiresIn}, domain: 'email') }}
    </p>
    <p>
        {{ translate('Pour ne rater aucun bon plan, crée une alerte : on te prévient dès qu’un créneau correspond à tes envies.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ alertsUrl }}" style="{{ styles.button }}">
            {{ translate('Créer une alerte', domain: 'email') }}
        </a>
        <a href="{{ homeUrl }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Voir les créneaux du moment', domain: 'email') }}
        </a>
    </p>

{% endblock %}