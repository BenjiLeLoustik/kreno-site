{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('Le paiement de la facture n°{number} ({amount} TTC) a échoué.', {
            number: invoice.number,
            amount: amount
        }, domain: 'email') }}
    </p>
    {% if paymentMethod %}
        <p>
            {{ translate('Moyen de paiement utilisé : {paymentMethod}', {paymentMethod: paymentMethod.label}, domain: 'email') }}
            {% if paymentMethod.expiry %}
                {{ translate('(expire {expiry})', {expiry: paymentMethod.expiry}, domain: 'email') }}
            {% endif %}.
        </p>
    {% endif %}
    {% if failure %}
        <p>
            {{ translate('Raison indiquée par la banque : {failure}', {failure: failure}, domain: 'email') }}
        </p>
    {% endif %}
    {% if final %}
        <p>
            {{ translate('C’était notre dernière tentative automatique.', domain: 'email') }}
            {% if graceUntil %}
                {{ translate('Sans règlement avant le {until}, vos créneaux ne seront plus publiés.', {until: graceUntil}, domain: 'email') }}
            {% endif %}
        </p>
    {% elseif nextRetryAt %}
        <p>
            {{ translate('Nous réessaierons automatique le {nextRetry}. Vous pouvez aussi régler dès maintenant.', {nextRetry: nextRetryAt}, domain: 'email') }}
        </p>
    {% endif %}
    <p style="{{ styles.actions }}">
        <a href="{{ invoice.payUrl }}" style="{{ styles.button }}">
            {{ translate('Régler la facture', domain: 'email') }}
        </a>
        <a href="{{ billingUrl }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Changer de moyen de paiement', domain: 'email') }}
        </a>
    </p>

{% endblock %}