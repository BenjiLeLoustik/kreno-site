{% extends "emails/layouts/_base.html.twig" %}

{% set mailType = 'pro' %}

{% block mailContent %}

    <p>
        {{ translate('{establishment} est en ligne et votre abonnement est actif', {establishment: establishment}, domain: 'email') }}
    </p>
    <ul style="{{ styles.list }}">
        <li style="{{ styles.item }}">
            {{ translate('Formule :', domain: 'email' )}} {{ subscription.plan }} ({{ subscription.period|lower }})
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Prix : {price} HT', {price: subscription.price}, domain: 'email') }}
        </li>
        <li style="{{ styles.item }}">
            {{ translate('Début : ', domain: 'email') }} {{ subscription.startedAt }}
        </li>
        {% if subscription.periodEnd %}
            <li style="{{ styles.item }}">
                {{ translate('Prochaine échéance :', domain: 'email') }} {{ subscription.periodEnd }}
            </li>
        {% endif %}
        {% if subscription.commissionFree %}
            <li style="{{ styles.item }}">
                {{ translate('Aucune commission sur vos réservations', domain: 'email') }}
            </li>
        {% endif %}
    </ul>
    <p>
        {{ translate('Vos factures seront disponibles dans votre espace facturation.', domain: 'email') }}
    </p>
    <p style="{{ styles.actions }}">
        <a href="{{ slotUrl }}" style="{{ styles.button }}">
            {{ translate('Publier un créneau', domain: 'email') }}
        </a>
        <a href="{{ subscription.url }}" style="{{ styles.buttonSecondary }}">
            {{ translate('Mon abonnement', domain: 'email') }}
        </a>
    </p>

{% endblock %}