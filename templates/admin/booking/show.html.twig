{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'bookings' %}
{% set tones = {
    coming: 'info',
    pending: 'warning',
    done: 'success',
    noshow: 'danger',
    cancelled: 'neutral',
    cancelled_by_establishment: 'danger'
} %}

{% block title %}
    {{ translate('Réservation {reference} · Administration Kréno', {reference: booking.reference}) }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <div>
            <a href="{{ path('admin_bookings') }}" class="admin-subtitle">
                {{ translate('← Toutes les réservations') }}
            </a>
            <h1 class="admin-title">
                {{ translate('Réservation {reference}', {reference: booking.reference}) }}
            </h1>
        </div>
        <span class="admin-badge admin-badge--{{ tones[booking.kind] ?? 'neutral' }}">
            {{ booking.statusLabel }}
        </span>
    </div>

    <div class="admin-grid">
        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Créneau') }}
            </h2>
            <dl class="admin-facts">
                <dt class="admin-facts__label">
                    {{ translate('Prestation') }}
                </dt>
                <dd class="admin-facts__value">
                    {{ booking.what ?: '-' }}
                    {% if booking.duration %}
                        · {{ booking.duration }}
                    {% endif %}
                </dd>
                <dt class="admin-facts__label">
                    {{ translate('Date') }}
                </dt>
                <dd class="admin-facts__value">
                    {{ booking.startsAt ? booking.startsAt|date('d/m/Y, H:i') : '-' }}
                </dd>
                <dt class="admin-facts__label">
                    {{ translate('Établissement') }}
                </dt>
                <dd class="admin-facts__value">
                    {% if booking.establishment %}
                        {% if is_granted('ROLE_MODERATOR') and route_exists('admin_establishment_show') %}
                            <a href="{{ path('admin_establishment_show', { id: booking.establishment.id }) }}">
                                {{ booking.establishment.name }}
                            </a>
                        {% else %}
                            {{ booking.establishment.name }}
                        {% endif %}
                        <br>
                        <span class="admin-row__meta">
                        {{ booking.establishment.address }}
                    </span>
                    {% else %}
                        -
                    {% endif %}
                </dd>
                <dt class="admin-facts__label">
                    {{ translate('Prix payé sur place') }}
                </dt>
                <dd class="admin-facts__value">
                    {{ booking.price }}
                    <s class="admin-row__meta">
                        {{ booking.old }}
                    </s>
                    {% if booking.discountLabel %}
                        · {{ booking.discountLabel }}
                    {% endif %}
                </dd>
                <dt class="admin-facts__label">
                    {{ translate('Commission Kréno') }}
                </dt>
                <dd class="admin-facts__value">
                    {{ booking.fee }}
                </dd>
                <dt class="admin-facts__label">
                    {{ translate('Réservée le') }}
                </dt>
                <dd class="admin-facts__value">
                    {{ booking.createdAt ? booking.createdAt|date('d/m/Y, H:i') : '-' }}
                </dd>
                {% if booking.note %}
                    <dt class="admin-facts__label">
                        {{ translate('Note du client') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ booking.note }}
                    </dd>
                {% endif %}
                {% if booking.cancelledAt %}
                    <dt class="admin-facts__label">
                        {{ translate('Annulée le') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ booking.cancelledAt|date('d/m/Y, H:i') }}
                        {% if booking.cancelledBy %}
                            {{ translate('par {cancelledBy}', {cancelledBy: booking.cancelledBy}) }}
                        {% endif %}
                    </dd>
                    {% if booking.cancellationReason %}
                        <dt class="admin-facts__label">
                            {{ translate('Motif') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ booking.cancellationReason }}
                        </dd>
                    {% endif %}
                {% endif %}
            </dl>
        </section>

        <div class="admin-form">
            <section class="admin-card">
                <h2 class="admin-card__title">
                    {{ translate('Client') }}
                </h2>
                {% if booking.customer %}
                    <dl class="admin-facts">
                        <dt class="admin-facts__label">
                            {{ translate('Nom') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {% if is_granted('ROLE_MODERATOR') and route_exists('admin_user_show') %}
                                <a href="{{ path('admin_user_show', { id: booking.customer.id }) }}">
                                    {{ booking.customer.name }}
                                </a>
                            {% else %}
                                {{ booking.customer.name }}
                            {% endif %}
                        </dd>
                        <dt class="admin-facts__label">
                            {{ translate('E-mail') }}
                        </dt>
                        <dd class="admin-facts__value">
                            <a href="mailto:{{ booking.customer.email }}">
                                {{ booking.customer.email }}
                            </a>
                        </dd>
                        <dt class="admin-facts__label">
                            {{ translate('Téléphone') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ booking.customer.phone ?: '-' }}
                        </dd>
                    </dl>
                {% else %}
                    <p class="admin-subtitle">
                        {{ translate('Compte supprimé.') }}
                    </p>
                {% endif %}
            </section>

            <section class="admin-card">
                <h2 class="admin-card__title">
                    {{ translate('Historique') }}
                </h2>
                <ol class="admin-timeline">
                    {% for step in booking.timeline %}
                        <li class="admin-timeline__item">
                            <span class="admin-timeline__dot admin-timeline__dot--{{ step.tone }}" aria-hidden="true"></span>
                            {{ step.label }}
                            {% if step.at %}
                                <span class="admin-timeline__time">
                                    {{ step.at|date('d/m H:i') }}
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </section>
        </div>
    </div>
{% endblock %}