{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'moderation' %}
{% set checkLabels = {
    siretMatchesCompany: translate('SIRET cohérent avec l\'entreprise'),
    hasAddress: translate('Adresse renseignée'),
    hasPhotosAndDescription: translate('Photos et description renseignées'),
} %}

{% block title %}
    {{ translate('Modération des pros · Administration Kréno') }}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/pages/admin/moderation.js') }}" defer></script>
{% endblock %}

{% block content %}
    <h1 class="admin-title">
        {{ translate('Modération des pros') }}
    </h1>

    <div class="moderation">
        <div class="moderation-list">
            {% for group in [
                {
                    title: translate('À vérifier'),
                    items: pending,
                    empty: translate('Aucun établissement à vérifier pour le moment.')
                },
                {
                    title: translate('Décisions récentes'),
                    items: recent,
                    empty: null
                },
            ] %}
                {% if group.items is not empty or group.empty %}
                    <div class="moderation-list__group">
                        <span class="moderation-list__title">
                            {{ group.title }}
                            {% if group.items is not empty %}
                                · {{ group.items|length }}
                            {% endif %}
                        </span>
                        {% for establishment in group.items %}
                            {% set current = selected and selected.id == establishment.id %}
                            <a href="{{ path('admin_moderation_show', { id: establishment.id }) }}" class="moderation-list__item{{ current ? ' moderation-list__item--active' : '' }}"{{ current ? ' aria-current="page"' : '' }}>
                                <span class="moderation-list__text">
                                    <b class="moderation-list__name">
                                        {{ establishment.name }}
                                    </b>
                                    <span class="moderation-list__meta">
                                        {% if establishment.category %}
                                            {{ establishment.category.name }}
                                        {% else %}
                                            Sans catégorie
                                        {% endif %}
                                        {% if establishment.city %}
                                            · {{ establishment.city.name }}
                                        {% endif %}
                                    </span>
                                </span>
                                <span class="moderation-status moderation-status--{{ establishment.status }}">
                                    {{ establishment.statusLabel }}
                                </span>
                            </a>
                        {% else %}
                            <p class="moderation-list__empty">
                                {{ group.empty }}
                            </p>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        {% if selected %}
            <section class="moderation-detail">
                <div class="moderation-detail__head">
                    <div class="moderation-detail__heading">
                        <h2 class="moderation-detail__title">
                            {{ selected.name }}
                        </h2>
                        {% if selected.submittedAt %}
                            <span class="moderation-detail__muted">
                                {{ translate('Envoyé le {submittedAt}', {
                                    submittedAt: selected.submittedAt|date('d/m/Y, H:i')
                                }) }}
                            </span>
                        {% endif %}
                    </div>
                    <span class="moderation-status moderation-status--{{ selected.status }} moderation-status--large">
                        {{ selected.statusLabel }}
                    </span>
                </div>

                <dl class="moderation-facts">
                    <dt class="moderation-facts__label">
                        {{ translate('Activité') }}
                    </dt>
                    <dd class="moderation-facts__value">
                        {{ selected.category ? selected.category.name : '-' }}
                    </dd>
                    <dt class="moderation-facts__label">
                        {{ translate('Adresse') }}
                    </dt>
                    <dd class="moderation-facts__value">
                        {{ selected.address ?: '-' }}
                    </dd>
                    <dt class="moderation-facts__label">
                        {{ translate('SIRET') }}
                    </dt>
                    <dd class="moderation-facts__value moderation-facts__value--number">
                        {{ selected.siretLabel ?: '-' }}
                        {% if selected.apeCode %}
                            {{ translate('· APE {apeCode}', {apeCode: selected.apeCode}) }}
                        {% endif %}
                    </dd>
                    {% if selected.company %}
                        <dt class="moderation-facts__label">
                            {{ translate('Entreprise') }}
                        </dt>
                        <dd class="moderation-facts__value">
                            {{ selected.company.legalName ?: selected.company.name }}
                            {{ translate('· SIREN {siren}', {siren: selected.company.siren}) }}
                        </dd>
                    {% endif %}
                    <dt class="moderation-facts__label">
                        {{ translate('Responsable') }}
                    </dt>
                    <dd class="moderation-facts__value">
                        {% if selected.owner %}
                            {{ selected.owner.name }}
                            <span class="moderation-facts__contact">
                                <a href="mailto:{{ selected.owner.email }}">
                                    {{ selected.owner.email }}
                                </a>
                                {% if selected.owner.phone %}
                                    · {{ selected.owner.phone }}
                                {% endif %}
                            </span>
                        {% else %}
                            -
                        {% endif %}
                    </dd>
                    <dt class="moderation-facts__label">
                        {{ translate('Formule') }}
                    </dt>
                    <dd class="moderation-facts__value">
                        {{ selected.plan ?: '-' }}
                    </dd>
                    <dt class="moderation-facts__label">
                        {{ translate('Fiche') }}
                    </dt>
                    <dd class="moderation-facts__value">
                        {{ translate('{services, plural, =1 {# prestation} other {# prestations}} · {photos, plural, =1 {# photo} other {# photos}}', {
                            services: selected.servicesCount,
                            photos: selected.imagesCount
                        }) }}
                    </dd>
                </dl>

                {% if selected.description %}
                    <p class="moderation-detail__description">
                        {{ selected.description }}
                    </p>
                {% endif %}

                <div class="moderation-checks">
                    <b class="moderation-checks__title">
                        {{ translate('Vérifications') }}
                    </b>
                    {% for key, label in checkLabels %}
                        {% set ok = selected.checks[key] ?? false %}
                        <span class="moderation-checks__item">
                            <span class="moderation-checks__mark moderation-checks__mark--{{ ok ? 'ok' : 'ko' }}" aria-hidden="true">
                                {{ ok ? '✓' : '!' }}
                            </span>
                            {{ label }}
                            <span class="sr-only">
                                : {{ ok ? translate('oui') : translate('non') }}
                            </span>
                        </span>
                    {% endfor %}
                </div>

                {% if selected.status == 'pending_review' %}
                    <form method="post" action="{{ path('admin_moderation_approve', { id: selected.id }) }}" class="moderation-form">
                        {{ csrf_field('admin_moderation')|raw }}
                        <label for="moderation-reason" class="moderation-form__field">
                            {{ translate('Motif en cas de refus') }}
                            <select id="moderation-reason" name="reason" class="moderation-form__input">
                                {% for reason in rejectionReasons %}
                                    <option value="{{ reason.value }}">
                                        {{ reason.label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>
                        <label for="moderation-message" class="moderation-form__field">
                            Message au pro
                            <span class="moderation-detail__muted">
                                {{ translate('(facultatif, pour un refus ou un justificatif)') }}
                            </span>
                            <textarea id="moderation-message" name="message" rows="3" maxlength="2000" class="moderation-form__input moderation-form__input--area"></textarea>
                        </label>
                        <div class="moderation-form__actions">
                            <button type="submit" class="moderation-button moderation-button--approve">
                                {{ translate('Valider et mettre en ligne') }}
                            </button>
                            <button type="submit" formaction="{{ path('admin_moderation_reject', { id: selected.id }) }}" class="moderation-button moderation-button--reject" data-confirm="{{ translate('Refuser {name} ? Le pro sera prévenu par e-mail.', {name: selected.name}) }}">
                                {{ translate('Refuser') }}
                            </button>
                            <button type="submit" formaction="{{ path('admin_moderation_request_document', { id: selected.id }) }}" class="moderation-button">
                                {{ translate('Demander un justificatif') }}
                            </button>
                        </div>
                    </form>
                {% else %}
                    <div class="moderation-decision">
                        {% if selected.status == 'rejected' %}
                            <span>
                                Refusé
                                {% if selected.rejectionReason %}
                                    : {{ selected.rejectionReason }}
                                {% endif %}
                            </span>
                        {% elseif selected.verifiedAt %}
                            <span>
                                {{ translate('Validé le {verifiedAt}', {verifiedAt: selected.verifiedAt|date('d/m/Y, H:i')}) }}
                            </span>
                        {% else %}
                            <span>
                                {{ translate('Statut actuel : {label}.', {label: selected.statusLabel}) }}
                            </span>
                        {% endif %}
                    </div>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}