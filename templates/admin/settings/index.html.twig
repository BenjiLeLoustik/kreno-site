{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'settings' %}

{% block title %}
    {{ translate('Réglages et journal · Administration Kréno') }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <h1 class="admin-title">
            {{ translate('Réglages et journal') }}
        </h1>
        <form method="get" action="{{ path('admin_settings_index') }}" class="admin-toolbar">
            <select name="version" class="admin-select" aria-label="{{ translate('Version du site') }}" data-admin-auto>
                {% for version in versions %}
                    <option value="{{ version.code }}"{{ version.code == selected.code ? ' selected' : '' }}>
                        {{ translate('{code} · {name} ({status})', {
                            code: version.code,
                            name: version.name,
                            status: version.statusLabel|lower
                        }) }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-button" data-admin-apply>
                {{ translate('Afficher') }}
            </button>
        </form>
    </div>

    <div class="admin-grid">
        <section class="admin-card">
            <div class="admin-card__head">
                <div>
                    <h2 class="admin-card__title">
                        {{ translate('Règles de la plateforme') }}
                    </h2>
                    <span class="admin-card__subtitle">
                        {{ translate('Version {code} · {status}', {
                            code: selected.code,
                            status: selected.statusLabel
                        }) }}
                    </span>
                </div>
                {% if route_exists('admin_website_show') %}
                    <a href="{{ path('admin_website_show', { code: selected.code }) }}" class="admin-button admin-button--small">
                        {{ translate('Gérer la version') }}
                    </a>
                {% endif %}
            </div>

            {% if not selected.editable %}
                <div class="admin-note">
                    {{ translate("Cette version n'est plus modifiable. Duplique-la depuis « Versions du site » pour changer les règles.") }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('admin_settings_update', { code: selected.code }) }}" class="admin-form">
                {{ csrf_field('admin_settings')|raw }}
                {% for group in rules.groups %}
                    <fieldset class="settings-group">
                        <legend class="settings-group__title">
                            {{ group.title }}
                        </legend>
                        <div class="admin-form__row">
                            {% for rule in group.rules %}
                                <label class="admin-field">
                                    {{ rule.label }}
                                    <span class="settings-input">
                                        <input type="number" name="{{ rule.key }}" value="{{ rule.value }}" min="0" required class="admin-input"{{ selected.editable ? '' : ' disabled' }}>
                                        <span class="settings-input__unit">
                                            {{ rule.unit }}
                                        </span>
                                    </span>
                                    {% if rule.changed %}
                                        <span class="admin-diff">
                                            {{ translate('En ligne : {value} {unit}', {
                                                value: rule.liveValue,
                                                unit: rule.unit
                                            }) }}
                                        </span>
                                    {% endif %}
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                {% endfor %}
                {% if rules.userSummary %}
                    <div class="admin-note">
                        {{ translate('Ce que voient les clients : {summary}', { summary: rules.userSummary }) }}
                    </div>
                {% endif %}
                {% if selected.editable %}
                    <div class="admin-actions">
                        <button type="submit" class="admin-button admin-button--primary">
                            {{ translate('Enregistrer les règles') }}
                        </button>
                    </div>
                {% endif %}
            </form>
        </section>

        <section class="admin-card">
            <div class="admin-card__head">
                <h2 class="admin-card__title">
                    {{ translate('Équipe Kréno') }}
                </h2>
                {% if route_exists('admin_team') %}
                    <a href="{{ path('admin_team') }}" class="admin-button admin-button--small">
                        {{ translate("Gérer l'équipe") }}
                    </a>
                {% endif %}
            </div>
            <div class="admin-rows">
                {% for member in members %}
                    <div class="admin-row">
                        <span class="admin-avatar" aria-hidden="true">
                            {{ member.initials }}
                        </span>
                        <span class="admin-row__main">
                            <b>
                                {{ member.name }}
                                {% if member.isMe %}
                                    {{ translate('(vous)') }}
                                {% endif %}
                            </b>
                            <span class="admin-row__meta">
                                {{ member.email }}
                            </span>
                        </span>
                        <span class="admin-badge">
                            {% if member.pending %}
                                {{ translate('Invité') }}
                            {% else %}
                                {{ member.roleLabel }}
                            {% endif %}
                        </span>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>

    <section class="admin-card">
        <div class="admin-card__head">
            <h2 class="admin-card__title">
                {{ translate("Journal d'activité") }}
            </h2>
            <div class="admin-toolbar">
                <nav class="admin-tabs" aria-label="{{ translate("Type d'activité") }}">
                    {% for filter in journal.filters %}
                        <a href="{{ path('admin_settings_index', { version: selected.code, group: filter.key != 'all' ? filter.key : null }|filter(value => value)) }}" class="admin-tabs__link{{ filter.selected ? ' admin-tabs__link--active' : '' }}">
                            {{ filter.label }}
                        </a>
                    {% endfor %}
                </nav>
                {% if route_exists('admin_log') %}
                    <a href="{{ path('admin_log', { group: journal.group != 'all' ? journal.group : null }|filter(value => value)) }}" class="admin-button admin-button--small">
                        {{ translate('Tout le journal') }}
                    </a>
                {% endif %}
            </div>
        </div>
        {% include 'admin/settings/_journal.html.twig' %}
    </section>
{% endblock %}