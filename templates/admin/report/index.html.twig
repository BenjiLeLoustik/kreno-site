{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'reports' %}
{% set query = { status: filter, direction: direction }|filter(value => value) %}
{% set decisions = selected ? [
    { value: 'dismiss', label: 'Classer sans suite', modifier: 'neutral' },
    { value: 'resolve', label: 'Marquer comme traité', modifier: 'neutral' },
    { value: 'warn', label: 'Envoyer un avertissement', modifier: 'warn' },
    { value: 'suspend', label: selected.suspendLabel, modifier: 'danger' },
] : [] %}

{% block title %}Signalements · Administration Kréno{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/pages/admin/report.js') }}" defer></script>
{% endblock %}

{% block content %}
    <div class="report-head">
        <h1 class="admin-title">Signalements</h1>
        <span class="report-head__count">{{ openCount }} ouvert{{ openCount > 1 ? 's' : '' }}</span>
    </div>

    <form method="get" action="{{ path('admin_reports') }}" class="report-filters" data-report-filters>
        <nav class="report-tabs" aria-label="Statut">
            {% for item in filters %}
                <a href="{{ path('admin_reports', { status: item.key, direction: direction }|filter(value => value)) }}" class="report-tabs__link{{ item.key == filter ? ' report-tabs__link--active' : '' }}"{{ item.key == filter ? ' aria-current="page"' : '' }}>{{ item.label }}</a>
            {% endfor %}
        </nav>
        <input type="hidden" name="status" value="{{ filter }}">
        <select name="direction" class="report-filters__select" aria-label="Origine" data-report-auto>
            <option value="">Toutes les origines</option>
            {% for item in directions %}
                <option value="{{ item.key }}"{{ item.key == direction ? ' selected' : '' }}>{{ item.label }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="report-filters__apply" data-report-apply>Filtrer</button>
    </form>

    <div class="report-table">
        <table class="report-table__table">
            <thead>
            <tr>
                <th scope="col" class="report-table__th">Motif</th>
                <th scope="col" class="report-table__th">Concerne</th>
                <th scope="col" class="report-table__th">Signalé par</th>
                <th scope="col" class="report-table__th">Date</th>
                <th scope="col" class="report-table__th">Priorité</th>
                <th scope="col" class="report-table__th">Statut</th>
            </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                {% set current = selected and selected.id == row.id %}
                <tr class="report-table__row{{ current ? ' report-table__row--active' : '' }}">
                    <td class="report-table__td">
                        <a href="{{ path('admin_report_show', { id: row.id }|merge(query)) }}" class="report-table__link"{{ current ? ' aria-current="true"' : '' }}>{{ row.reasonLabel ?: 'Signalement' }}</a>
                    </td>
                    <td class="report-table__td">{{ row.target ?: '—' }}</td>
                    <td class="report-table__td report-table__td--muted">{{ row.by ?: '—' }}</td>
                    <td class="report-table__td report-table__td--muted report-table__td--nowrap">{{ row.date }}</td>
                    <td class="report-table__td"><span class="admin-priority admin-priority--{{ row.priority }}">{{ row.priorityLabel }}</span></td>
                    <td class="report-table__td"><span class="report-status report-status--{{ row.kind }}">{{ row.status }}</span></td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="report-table__empty">Aucun signalement pour ce filtre.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if selected %}
        <section class="report-detail">
            <div class="report-detail__main">
                <div class="report-detail__head">
                    <h2 class="report-detail__title">{{ selected.reasonLabel ?: 'Signalement' }}{% if selected.target %} · {{ selected.target }}{% endif %}</h2>
                    <span class="report-status report-status--{{ selected.kind }}">{{ selected.status }}</span>
                </div>
                <span class="report-detail__meta">
                    {{ selected.reference }}
                    {% if selected.booking %} · Réservation {{ selected.booking.reference }} ({{ selected.booking.price }}){% endif %}
                    · signalé par {{ selected.by ?: '—' }}, {{ selected.date }}
                </span>
                {% if selected.message %}
                    <blockquote class="report-detail__quote">« {{ selected.message }} »</blockquote>
                {% endif %}
                <span class="report-detail__history"><b>Historique :</b> {{ selected.history }}</span>
                {% if selected.attachment and route_exists('admin_report_attachment') %}
                    <a href="{{ path('admin_report_attachment', { id: selected.id }) }}" class="report-detail__attachment" target="_blank" rel="noopener">
                        <i data-lucide="{{ selected.attachment.type == 'pdf' ? 'file-text' : 'image' }}" class="admin-nav__icon"></i>
                        {{ selected.attachment.name }}
                    </a>
                {% endif %}

                {% if selected.messages is not empty %}
                    <div class="report-thread">
                        <b class="report-thread__title">Échanges</b>
                        {% for message in selected.messages %}
                            <div class="report-thread__item{{ message.internal ? ' report-thread__item--internal' : '' }}">
                                <span class="report-thread__author">
                                    {{ message.author }}{% if message.internal %} · note interne{% endif %}
                                    {% if message.createdAt %}<span class="report-thread__date">{{ message.createdAt|date('d/m/Y H:i') }}</span>{% endif %}
                                </span>
                                <p class="report-thread__body">{{ message.body|nl2br }}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('admin_report_note', { id: selected.id }) }}" class="report-note">
                    {{ csrf_field('admin_report')|raw }}
                    <label for="report-note" class="moderation-form__field">
                        Note interne
                        <textarea id="report-note" name="body" rows="2" required minlength="2" maxlength="2000" class="moderation-form__input moderation-form__input--area" placeholder="Visible uniquement par l'équipe Kréno"></textarea>
                    </label>
                    <button type="submit" class="moderation-button report-note__submit">Ajouter la note</button>
                </form>
            </div>

            <div class="report-detail__aside">
                <b class="report-detail__aside-title">Décision</b>
                {% if selected.canDecide %}
                    {% if selected.kind == 'sent' %}
                        <form method="post" action="{{ path('admin_report_review', { id: selected.id }) }}">
                            {{ csrf_field('admin_report')|raw }}
                            <button type="submit" class="report-decision report-decision--neutral">Prendre en charge</button>
                        </form>
                    {% endif %}
                    <form method="post" action="{{ path('admin_report_decision', { id: selected.id }) }}" class="report-decision-form">
                        {{ csrf_field('admin_report')|raw }}
                        <input type="hidden" name="days" value="30">
                        <label for="report-message" class="moderation-form__field">
                            Message aux deux parties
                            <textarea id="report-message" name="message" rows="3" required minlength="5" maxlength="1000" class="moderation-form__input moderation-form__input--area"></textarea>
                        </label>
                        {% for decision in decisions %}
                            <button type="submit" name="decision" value="{{ decision.value }}" class="report-decision report-decision--{{ decision.modifier }}"{% if decision.value == 'suspend' %} data-confirm="{{ decision.label }} ?"{% endif %}>{{ decision.label }}</button>
                        {% endfor %}
                    </form>
                    <span class="report-detail__hint">Les deux parties sont prévenues par e-mail de la décision.</span>
                {% else %}
                    <div class="moderation-decision">
                        {{ selected.status }}{% if selected.resolution and selected.resolution != selected.status %} : {{ selected.resolution }}{% endif %}
                        {% if selected.handledBy %}<br><span class="report-detail__hint">Traité par {{ selected.handledBy }}{% if selected.handledAt %} le {{ selected.handledAt|date('d/m/Y') }}{% endif %}.</span>{% endif %}
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}
{% endblock %}