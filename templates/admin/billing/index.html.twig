{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'billing' %}
{% set tones = {
    paid: 'success',
    pending: 'warning',
    failed: 'danger',
    retry: 'warning',
    none: 'neutral'
} %}

{% set invoiceTones = {
    paid: 'success',
    failed: 'danger',
    refunded: 'info',
    void: 'neutral',
    open: 'warning'
} %}

{% block title %}
    {{ translate('Facturation · Administration Kréno') }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <h1 class="admin-title">
            {{ translate('Facturation') }}
        </h1>
        <form method="get" action="{{ company ? path('admin_billing_company', { id: company.id }) : path('admin_billing') }}" class="admin-toolbar">
            <select name="month" class="admin-select" aria-label="{{ translate('Période') }}" data-admin-auto>
                {% for item in months %}
                    <option value="{{ item.value }}"{{ item.value == month ? ' selected' : '' }}>
                        {{ item.label }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-button" data-admin-apply>
                {{ translate('Afficher') }}
            </button>
        </form>
    </div>

    <div class="admin-stats">
        {% for kpi in kpis %}
            <div class="admin-stat">
                <span class="admin-stat__label">
                    {{ kpi.label }}
                </span>
                <strong class="admin-stat__value{{ kpi.tone == 'danger' and kpi.value != '0' ? ' admin-stat__value--alert' : '' }}">
                    {{ kpi.value }}
                </strong>
                <span class="admin-stat__note">
                    {{ kpi.note }}
                </span>
            </div>
        {% endfor %}
    </div>

    <div class="admin-table">
        <table class="admin-table__table">
            <thead>
            <tr>
                <th scope="col" class="admin-table__th">
                    {{ translate('Entreprise') }}
                </th>
                <th scope="col" class="admin-table__th">
                    {{ translate('Formule') }}
                </th>
                <th scope="col" class="admin-table__th">
                    {{ translate('Établissements') }}
                </th>
                <th scope="col" class="admin-table__th">
                    {{ translate('Dernière facture') }}
                </th>
                <th scope="col" class="admin-table__th">
                    {{ translate('Statut') }}
                </th>
                <th scope="col" class="admin-table__th">
                    {{ translate('Échéance') }}
                </th>
            </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                {% set current = selected and selected.companyId == row.companyId %}
                <tr class="admin-table__row{{ current ? ' admin-table__row--active' : '' }}">
                    <td class="admin-table__td">
                        {% if row.companyId %}
                            <a href="{{ path('admin_billing_company', { id: row.companyId, month: month }) }}" class="admin-table__link"{{ current ? ' aria-current="true"' : '' }}>
                                {{ row.company }}
                            </a>
                        {% else %}
                            {{ row.company ?: '-' }}
                        {% endif %}
                    </td>
                    <td class="admin-table__td">
                        {{ row.plan ?: '-' }}
                    </td>
                    <td class="admin-table__td admin-table__td--muted">
                        {{ row.estabs }}
                    </td>
                    <td class="admin-table__td admin-table__td--number">
                        {{ row.amount }}
                    </td>
                    <td class="admin-table__td">
                        <span class="admin-badge admin-badge--{{ tones[row.kind] ?? 'neutral' }}">
                            {{ row.status }}
                        </span>
                    </td>
                    <td class="admin-table__td admin-table__td--muted admin-table__td--nowrap">
                        {{ row.next ?: '-' }}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="admin-table__empty">
                        {{ translate('Aucun abonnement en cours.') }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if company and not selected %}
        <div class="admin-note">
            {{ translate('{company} n\'a pas d\'abonnement en cours.', {company: company.name}) }}
        </div>
    {% endif %}

    {% if selected %}
        <div class="admin-grid">
            <section class="admin-card">
                <div class="admin-card__head">
                    <div>
                        <h2 class="admin-detail__title">
                            {{ selected.company }}
                        </h2>
                        <span class="admin-card__subtitle">
                            {{ selected.estabs }}
                            {% if selected.since %}
                                {{ translate('· client depuis le {since}', {since: selected.since}) }}
                            {% endif %}
                        </span>
                    </div>
                    <span class="admin-badge admin-badge--{{ tones[selected.kind] ?? 'neutral' }}">
                        {{ selected.status }}
                    </span>
                </div>

                {% if selected.alert %}
                    <div class="admin-note admin-note--danger">
                        {% set details = '' %}
                        {% if selected.alert.method and selected.alert.reason %}
                            {% set details = translate('sur {method} : {reason}', { method: selected.alert.method, reason: selected.alert.reason }) %}
                        {% elseif selected.alert.method %}
                            {% set details = translate('sur {method}', { method: selected.alert.method }) %}
                        {% elseif selected.alert.reason %}
                            {% set details = translate(': {reason}', { reason: selected.alert.reason }) %}
                        {% endif %}

                        {{ translate('Facture {invoice} ({amount} TTC) refusée le {date} {details}.', {
                            invoice: selected.alert.invoice,
                            amount: selected.alert.amountIncludingTax,
                            date: selected.alert.failedAt,
                            details: details
                        })|trim }}

                        {% if selected.alert.nextRetry %}
                            {{ translate('Prochaine tentative le {nextRetry}.', { nextRetry: selected.alert.nextRetry }) }}
                        {% endif %}

                        {% if selected.alert.graceUntil %}
                            {{ translate('Délai accordé jusqu\'au {graceUntil}.', { graceUntil: selected.alert.graceUntil }) }}
                        {% endif %}

                        {% if selected.alert.suspended %}
                            <b>
                                {{ translate('Services suspendus.') }}
                            </b>
                        {% endif %}
                    </div>
                {% endif %}

                <dl class="admin-facts">
                    <dt class="admin-facts__label">
                        {{ translate('Formule') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ selected.subscription.plan.name }} · {{ selected.subscription.periodLabel }} · {{ selected.subscription.statusLabel }}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Tarif') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ selected.subscription.priceLine }}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Engagement') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ selected.subscription.commitment }}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Moyen de paiement') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ selected.method ?: translate('Aucun') }}
                    </dd>
                    {% if selected.subscription.nextInvoice %}
                        <dt class="admin-facts__label">
                            {{ translate('Prochaine facture') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ translate('{nextInvoiceAmount} le {nextInvoiceDate}', {
                                nextInvoiceAmount: selected.subscription.nextInvoice.amount,
                                nextInvoiceDate: selected.subscription.nextInvoice.date
                            }) }}
                        </dd>
                    {% endif %}
                    {% if selected.subscription.promo %}
                        <dt class="admin-facts__label">
                            {{ translate('Promotion') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ selected.subscription.promo }}
                        </dd>
                    {% endif %}
                    {% if selected.subscription.scheduled %}
                        <dt class="admin-facts__label">
                            {{ translate('Changement prévu') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ translate('{scheduledPlan} le {scheduledDate}', {
                                scheduledPlan: selected.subscription.scheduled.plan,
                                scheduledDate: selected.subscription.scheduled.date
                            }) }}
                        </dd>
                    {% endif %}
                    {% if selected.subscription.cancelAt %}
                        <dt class="admin-facts__label">
                            {{ translate('Résiliation') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ translate('le {cancelAt}', {cancelAt: selected.subscription.cancelAt}) }}
                        </dd>
                    {% endif %}
                    {% if not selected.subscription.plan.perBooking %}
                        <dt class="admin-facts__label">
                            {{ translate('Établissements couverts') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ translate('{covered} sur {total}', {
                                covered: selected.subscription.establishments.covered,
                                total: selected.subscription.establishments.total
                            }) }}
                        </dd>
                    {% endif %}
                </dl>

                {% if selected.isFailed %}
                    <div class="admin-actions">
                        <form method="post" action="{{ path('admin_billing_retry', { id: selected.companyId }) }}">
                            {{ csrf_field('admin_billing')|raw }}
                            <button type="submit" class="admin-button admin-button--warning">
                                {{ translate('Relancer le prélèvement') }}
                            </button>
                        </form>
                    </div>
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">
                            {{ translate('Accorder un délai de paiement') }}
                        </summary>
                        <form method="post" action="{{ path('admin_billing_grace', { id: selected.companyId }) }}" class="admin-form admin-disclosure__body">
                            {{ csrf_field('admin_billing')|raw }}
                            <label class="admin-field">
                                {{ translate('Nombre de jours') }}
                                <input type="number" name="days" value="7" min="1" max="60" required class="admin-input">
                            </label>
                            <label class="admin-field">
                                {{ translate('Motif') }}
                                <textarea name="reason" rows="2" required minlength="5" maxlength="500" class="admin-input admin-input--area"></textarea>
                            </label>
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--primary">
                                    {{ translate('Accorder le délai') }}
                                </button>
                            </div>
                        </form>
                    </details>
                {% endif %}
            </section>

            <div class="admin-form">
                <section class="admin-card">
                    <h2 class="admin-card__title">
                        {{ translate('Modifier l\'abonnement') }}
                    </h2>
                    <form method="post" action="{{ path('admin_billing_subscription', { id: selected.companyId }) }}" class="admin-form">
                        {{ csrf_field('admin_billing')|raw }}
                        <div class="admin-form__row">
                            <label class="admin-field">
                                {{ translate('Formule') }}
                                <select name="plan" class="admin-input" required>
                                    {% for plan in plans %}
                                        <option value="{{ plan.code }}"{{ plan.code == selected.subscription.plan.code ? ' selected' : '' }}>
                                            {{ plan.name }} · {{ plan.price }} {{ plan.unit }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="admin-field">
                                Période
                                <select name="period" class="admin-input">
                                    <option value="monthly"{{ selected.subscription.period == 'monthly' ? ' selected' : '' }}>
                                        {{ translate('Mensuelle') }}
                                    </option>
                                    <option value="yearly"{{ selected.subscription.period == 'yearly' ? ' selected' : '' }}>
                                        {{ translate('Annuelle') }}
                                    </option>
                                </select>
                            </label>
                        </div>
                        <div class="admin-form__row">
                            <label class="admin-field">
                                {{ translate('Application') }}
                                <select name="application" class="admin-input">
                                    {% for application in applications %}
                                        <option value="{{ application.key }}">
                                            {{ application.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="admin-field">
                                {{ translate('Geste commercial') }}
                                <select name="gesture" class="admin-input">
                                    {% for gesture in gestures %}
                                        <option value="{{ gesture.key }}">
                                            {{ gesture.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </label>
                        </div>
                        <label class="admin-field">
                            {{ translate('Motif (noté dans le journal)') }}
                            <textarea name="reason" rows="2" required minlength="5" maxlength="500" class="admin-input admin-input--area"></textarea>
                        </label>
                        <div class="admin-actions">
                            <button type="submit" class="admin-button admin-button--primary" data-admin-confirm="{{ translate('Modifier l\'abonnement de {company} ? L\'entreprise sera prévenue par e-mail.', {company: selected.company}) }}">
                                {{ translate('Appliquer') }}
                            </button>
                        </div>
                    </form>
                </section>

                <section class="admin-card">
                    <h2 class="admin-card__title">
                        {{ translate('Factures') }}
                    </h2>
                    <div class="admin-rows">
                        {% for invoice in selected.invoices %}
                            <div class="admin-row">
                                <span class="admin-row__main">
                                    <b>
                                        {{ invoice.number }}
                                    </b>
                                    <span class="admin-row__meta">
                                        {{ invoice.date }} · {{ invoice.detail }}
                                    </span>
                                </span>
                                <span class="admin-row__actions">
                                    <span class="admin-table__td--number">
                                        {{ invoice.amount }}
                                    </span>
                                    <span class="admin-badge admin-badge--{{ invoiceTones[invoice.kind] ?? 'neutral' }}">
                                        {{ invoice.status }}
                                    </span>
                                    {% if route_exists('admin_billing_invoice_pdf') %}
                                        <a href="{{ path('admin_billing_invoice_pdf', { number: invoice.number }) }}" class="admin-button admin-button--small" target="_blank" rel="noopener">
                                            PDF
                                        </a>
                                    {% endif %}
                                </span>
                            </div>
                        {% else %}
                            <p class="admin-subtitle">
                                {{ translate('Aucune facture.') }}
                            </p>
                        {% endfor %}
                    </div>
                </section>
            </div>
        </div>
    {% endif %}
{% endblock %}