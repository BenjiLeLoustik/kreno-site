{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'users' %}
{% set query = { q: filters.q, status: filters.status, page: filters.page > 1 ? filters.page : null }|filter(value => value) %}
{% set statusTones = { active: 'success', suspended: 'warning', banned: 'danger', deleted: 'neutral' } %}

{% block title %}Utilisateurs · Administration Kréno{% endblock %}

{% block content %}
    <div class="admin-head">
        <h1 class="admin-title">Utilisateurs</h1>
        <form method="get" action="{{ path('admin_user_index') }}" class="admin-toolbar">
            <label class="admin-search">
                <i data-lucide="search" class="admin-nav__icon"></i>
                <input type="search" name="q" value="{{ filters.q }}" placeholder="Nom, e-mail, téléphone" class="admin-search__input" aria-label="Rechercher un utilisateur">
            </label>
            <select name="status" class="admin-select" aria-label="Statut" data-admin-auto>
                <option value="">Tous les statuts</option>
                {% for status in statuses %}
                    <option value="{{ status.value }}"{{ status.value == filters.status ? ' selected' : '' }}>{{ status.label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-button">Rechercher</button>
        </form>
    </div>

    <div class="admin-split">
        <div class="admin-split__list">
            {% for user in users %}
                {% set current = selected and selected.id == user.id %}
                <a href="{{ path('admin_user_show', { id: user.id }|merge(query)) }}" class="admin-list__item{{ current ? ' admin-list__item--active' : '' }}"{{ current ? ' aria-current="page"' : '' }}>
                    <span class="admin-list__text">
                        <b class="admin-list__name">{{ user.fullName }}</b>
                        <span class="admin-list__meta">{{ user.email }}</span>
                    </span>
                    <span class="admin-badge admin-badge--{{ statusTones[user.status] ?? 'neutral' }}">{{ user.statusLabel }}</span>
                </a>
            {% else %}
                <p class="admin-list__empty">Aucun utilisateur ne correspond à la recherche.</p>
            {% endfor %}
            {% if filters.page > 1 or hasNext %}
                <div class="admin-list__item admin-pagination">
                    {% if filters.page > 1 %}<a href="{{ path('admin_user_index', query|merge({ page: filters.page - 1 })) }}">← Précédents</a>{% else %}<span></span>{% endif %}
                    <span>Page {{ filters.page }}</span>
                    {% if hasNext %}<a href="{{ path('admin_user_index', query|merge({ page: filters.page + 1 })) }}">Suivants →</a>{% else %}<span></span>{% endif %}
                </div>
            {% endif %}
        </div>

        {% if selected %}
            <section class="admin-card admin-split__detail">
                <div class="admin-card__head">
                    <div>
                        <h2 class="admin-detail__title">{{ selected.fullName }}</h2>
                        <span class="admin-card__subtitle">
                            Inscrit le {{ selected.createdAt|date('d/m/Y') }}
                            {% if selected.isPro %} · compte pro{% endif %}
                            {% if selected.roles|filter(role => role starts with 'ROLE_' and role != 'ROLE_USER') is not empty %} · équipe Kréno{% endif %}
                        </span>
                    </div>
                    <span class="admin-badge admin-badge--{{ statusTones[selected.status] ?? 'neutral' }}">{{ selected.statusLabel }}</span>
                </div>

                <div class="admin-figures">
                    <div class="admin-figure"><span class="admin-figure__label">Réservations</span><strong class="admin-figure__value">{{ selected.stats.bookings }}</strong></div>
                    <div class="admin-figure"><span class="admin-figure__label">Honorées</span><strong class="admin-figure__value">{{ selected.stats.honored }}</strong></div>
                    <div class="admin-figure"><span class="admin-figure__label">Annulations</span><strong class="admin-figure__value">{{ selected.stats.cancelled }}</strong></div>
                    <div class="admin-figure"><span class="admin-figure__label">Absences</span><strong class="admin-figure__value">{{ selected.stats.noShows }}</strong></div>
                </div>

                <dl class="admin-facts">
                    <dt class="admin-facts__label">E-mail</dt>
                    <dd class="admin-facts__value"><a href="mailto:{{ selected.email }}">{{ selected.email }}</a>{% if not selected.emailVerified %} · <span class="admin-diff">non vérifié</span>{% endif %}</dd>
                    <dt class="admin-facts__label">Téléphone</dt>
                    <dd class="admin-facts__value">{{ selected.phone ?: '—' }}</dd>
                    <dt class="admin-facts__label">Dernière connexion</dt>
                    <dd class="admin-facts__value">{{ selected.lastLoginAt ? selected.lastLoginAt|date('d/m/Y à H:i') : 'Jamais' }}</dd>
                    <dt class="admin-facts__label">Absences récentes</dt>
                    <dd class="admin-facts__value">{{ selected.stats.recentNoShows }} sur {{ selected.stats.noShowWindowDays }} jours (tolérance : {{ selected.stats.toleratedNoShows }})</dd>
                    {% if selected.statusReason %}
                        <dt class="admin-facts__label">Motif</dt>
                        <dd class="admin-facts__value">{{ selected.statusReason }}</dd>
                    {% endif %}
                    {% if selected.suspendedUntil %}
                        <dt class="admin-facts__label">Suspendu jusqu'au</dt>
                        <dd class="admin-facts__value">{{ selected.suspendedUntil|date('d/m/Y à H:i') }}</dd>
                    {% endif %}
                </dl>

                <div class="admin-actions">
                    {% if route_exists('admin_bookings') %}
                        <a href="{{ path('admin_bookings', { q: selected.email }) }}" class="admin-button">Voir ses réservations</a>
                    {% endif %}
                    <a href="mailto:{{ selected.email }}" class="admin-button">Envoyer un e-mail</a>
                    {% if selected.status in ['suspended', 'banned'] %}
                        <form method="post" action="{{ path('admin_user_lift', { id: selected.id }) }}">
                            {{ csrf_field('admin_user')|raw }}
                            <button type="submit" class="admin-button admin-button--success">Réactiver le compte</button>
                        </form>
                    {% endif %}
                </div>

                {% if selected.status == 'active' %}
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">Suspendre les réservations</summary>
                        <form method="post" action="{{ path('admin_user_suspend', { id: selected.id }) }}" class="admin-form admin-disclosure__body">
                            {{ csrf_field('admin_user')|raw }}
                            <div class="admin-form__row">
                                <label class="admin-field">
                                    Durée (jours)
                                    <input type="number" name="days" value="{{ suspensionDays }}" min="1" max="365" required class="admin-input">
                                </label>
                            </div>
                            <label class="admin-field">
                                Motif (envoyé à l'utilisateur)
                                <textarea name="reason" rows="2" required minlength="3" maxlength="500" class="admin-input admin-input--area"></textarea>
                            </label>
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--warning">Suspendre</button>
                            </div>
                        </form>
                    </details>
                {% endif %}

                {% if selected.status != 'banned' and is_granted('ROLE_ADMIN') %}
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">Bannir définitivement</summary>
                        <form method="post" action="{{ path('admin_user_ban', { id: selected.id }) }}" class="admin-form admin-disclosure__body">
                            {{ csrf_field('admin_user')|raw }}
                            <label class="admin-field">
                                Motif
                                <textarea name="reason" rows="2" required minlength="3" maxlength="500" class="admin-input admin-input--area"></textarea>
                            </label>
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--danger" data-admin-confirm="Bannir {{ selected.fullName }} définitivement ?">Bannir</button>
                            </div>
                        </form>
                    </details>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}