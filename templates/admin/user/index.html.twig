{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'users' %}
{% set query = {
    q: filters.q,
    status: filters.status,
    page: filters.page > 1 ? filters.page : null
}|filter(value => value) %}

{% set statusTones = {
    active: 'success',
    suspended: 'warning',
    banned: 'danger',
    deleted: 'neutral'
} %}

{% block title %}
    {{ translate('Utilisateurs · Administration Kréno') }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <h1 class="admin-title">
            {{ translate('Utilisateurs') }}
        </h1>
        <form method="get" action="{{ path('admin_user_index') }}" class="admin-toolbar">
            <label class="admin-search">
                <i data-lucide="search" class="admin-nav__icon"></i>
                <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ translate('Nom, e-mail, téléphone') }}" class="admin-search__input" aria-label="{{ translate('Rechercher un utilisateur') }}">
            </label>
            <select name="status" class="admin-select" aria-label="{{ translate('Statut') }}" data-admin-auto>
                <option value="">
                    {{ translate('Tous les statuts') }}
                </option>
                {% for status in statuses %}
                    <option value="{{ status.value }}"{{ status.value == filters.status ? ' selected' : '' }}>
                        {{ status.label }}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-button">
                {{ translate('Rechercher') }}
            </button>
        </form>
    </div>

    <div class="admin-split">
        <div class="admin-split__list">
            {% for user in users %}
                {% set current = selected and selected.id == user.id %}
                <a href="{{ path('admin_user_show', { id: user.id }|merge(query)) }}" class="admin-list__item{{ current ? ' admin-list__item--active' : '' }}"{{ current ? ' aria-current="page"' : '' }}>
                    <span class="admin-list__text">
                        <b class="admin-list__name">
                            {{ user.fullName }}
                        </b>
                        <span class="admin-list__meta">
                            {{ user.email }}
                        </span>
                    </span>
                    <span class="admin-badge admin-badge--{{ statusTones[user.status] ?? 'neutral' }}">
                        {{ user.statusLabel }}
                    </span>
                </a>
            {% else %}
                <p class="admin-list__empty">
                    {{ translate('Aucun utilisateur ne correspond à la recherche.') }}
                </p>
            {% endfor %}
            {% if filters.page > 1 or hasNext %}
                <div class="admin-list__item admin-pagination">
                    {% if filters.page > 1 %}
                        <a href="{{ path('admin_user_index', query|merge({ page: filters.page - 1 })) }}">
                            {{ translate('← Précédents') }}
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}
                    <span>
                        {{ translate('Page {page}', { page: filters.page }) }}
                    </span>
                    {% if hasNext %}
                        <a href="{{ path('admin_user_index', query|merge({ page: filters.page + 1 })) }}">
                            {{ translate('Suivants →') }}
                        </a>
                    {% else %}
                        <span></span>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if selected %}
            <section class="admin-card admin-split__detail">
                <div class="admin-card__head">
                    <div>
                        <h2 class="admin-detail__title">
                            {{ selected.fullName }}
                        </h2>
                        <span class="admin-card__subtitle">
                            {{ translate('Inscrit le {date}{isPro}{isTeam}', {
                                date: selected.createdAt|date('d/m/Y'),
                                isPro: selected.isPro ? translate(' · compte pro') : '',
                                isTeam: (selected.roles|filter(role => role starts with 'ROLE_' and role != 'ROLE_USER') is not empty) ? translate(' · équipe Kréno') : ''
                            }) }}
                        </span>
                    </div>
                    <span class="admin-badge admin-badge--{{ statusTones[selected.status] ?? 'neutral' }}">
                        {{ selected.statusLabel }}
                    </span>
                </div>

                <div class="admin-figures">
                    <div class="admin-figure">
                        <span class="admin-figure__label">
                            {{ translate('Réservations') }}
                        </span>
                        <strong class="admin-figure__value">
                            {{ selected.stats.bookings }}
                        </strong>
                    </div>
                    <div class="admin-figure">
                        <span class="admin-figure__label">
                            {{ translate('Honorées') }}
                        </span>
                        <strong class="admin-figure__value">
                            {{ selected.stats.honored }}
                        </strong>
                    </div>
                    <div class="admin-figure">
                        <span class="admin-figure__label">
                            {{ translate('Annulations') }}
                        </span>
                        <strong class="admin-figure__value">
                            {{ selected.stats.cancelled }}
                        </strong>
                    </div>
                    <div class="admin-figure">
                        <span class="admin-figure__label">
                            {{ translate('Absences') }}
                        </span>
                        <strong class="admin-figure__value">
                            {{ selected.stats.noShows }}
                        </strong>
                    </div>
                </div>

                <dl class="admin-facts">
                    <dt class="admin-facts__label">
                        {{ translate('E-mail') }}
                    </dt>
                    <dd class="admin-facts__value">
                        <a href="mailto:{{ selected.email }}">
                            {{ selected.email }}
                        </a>
                        {% if not selected.emailVerified %}
                            ·
                            <span class="admin-diff">
                                {{ translate('non vérifié') }}
                            </span>
                        {% endif %}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Téléphone') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ selected.phone ?: '-' }}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Dernière connexion') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {% if selected.lastLoginAt %}
                            {{ selected.lastLoginAt|date('d/m/Y à H:i') }}
                        {% else %}
                            {{ translate('Jamais') }}
                        {% endif %}
                    </dd>
                    <dt class="admin-facts__label">
                        {{ translate('Absences récentes') }}
                    </dt>
                    <dd class="admin-facts__value">
                        {{ translate('{recentNoShows} sur {noShowWindowDays} jours (tolérance : {toleratedNoShows})', {
                            recentNoShows: selected.stats.recentNoShows,
                            noShowWindowDays: selected.stats.noShowWindowDays,
                            toleratedNoShows: selected.stats.toleratedNoShows
                        }) }}
                    </dd>
                    {% if selected.statusReason %}
                        <dt class="admin-facts__label">
                            {{ translate('Motif') }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ selected.statusReason }}
                        </dd>
                    {% endif %}
                    {% if selected.suspendedUntil %}
                        <dt class="admin-facts__label">
                            {{ translate("Suspendu jusqu'au") }}
                        </dt>
                        <dd class="admin-facts__value">
                            {{ selected.suspendedUntil|date('d/m/Y à H:i') }}
                        </dd>
                    {% endif %}
                </dl>

                <div class="admin-actions">
                    {% if route_exists('admin_bookings') %}
                        <a href="{{ path('admin_bookings', { q: selected.email }) }}" class="admin-button">
                            {{ translate('Voir ses réservations') }}
                        </a>
                    {% endif %}
                    <a href="mailto:{{ selected.email }}" class="admin-button">
                        {{ translate('Envoyer un e-mail') }}
                    </a>
                    {% if selected.status in ['suspended', 'banned'] %}
                        <form method="post" action="{{ path('admin_user_lift', { id: selected.id }) }}">
                            {{ csrf_field('admin_user')|raw }}
                            <button type="submit" class="admin-button admin-button--success">
                                {{ translate('Réactiver le compte') }}
                            </button>
                        </form>
                    {% endif %}
                </div>

                {% if selected.status == 'active' %}
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">
                            {{ translate('Suspendre les réservations') }}
                        </summary>
                        <form method="post" action="{{ path('admin_user_suspend', { id: selected.id }) }}" class="admin-form admin-disclosure__body">
                            {{ csrf_field('admin_user')|raw }}
                            <div class="admin-form__row">
                                <label class="admin-field">
                                    {{ translate('Durée (jours)') }}
                                    <input type="number" name="days" value="{{ suspensionDays }}" min="1" max="365" required class="admin-input">
                                </label>
                            </div>
                            <label class="admin-field">
                                {{ translate("Motif (envoyé à l'utilisateur)") }}
                                <textarea name="reason" rows="2" required minlength="3" maxlength="500" class="admin-input admin-input--area"></textarea>
                            </label>
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--warning">
                                    {{ translate('Suspendre') }}
                                </button>
                            </div>
                        </form>
                    </details>
                {% endif %}

                {% if selected.status != 'banned' and is_granted('ROLE_ADMIN') %}
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">
                            {{ translate('Bannir définitivement') }}
                        </summary>
                        <form method="post" action="{{ path('admin_user_ban', { id: selected.id }) }}" class="admin-form admin-disclosure__body">
                            {{ csrf_field('admin_user')|raw }}
                            <label class="admin-field">
                                {{ translate('Motif') }}
                                <textarea name="reason" rows="2" required minlength="3" maxlength="500" class="admin-input admin-input--area"></textarea>
                            </label>
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--danger" data-admin-confirm="{{ translate('Bannir {name} définitivement ?', { name: selected.fullName }) }}">
                                    {{ translate('Bannir') }}
                                </button>
                            </div>
                        </form>
                    </details>
                {% endif %}
            </section>
        {% endif %}
    </div>
{% endblock %}