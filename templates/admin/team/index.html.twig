{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'settings' %}

{% block title %}
    {{ translate('Équipe Kréno · Administration Kréno') }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <div>
            <a href="{{ path('admin_settings_index') }}" class="admin-subtitle">
                {{ translate('← Réglages et journal') }}
            </a>
            <h1 class="admin-title">
                {{ translate('Équipe Kréno') }}
            </h1>
        </div>
    </div>

    <div class="admin-grid">
        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Membres') }}
            </h2>
            <div class="admin-rows">
                {% for member in members %}
                    <div class="admin-row">
                        <span class="admin-avatar" aria-hidden="true">
                            {{ member.initials }}
                        </span>
                        <span class="admin-row__main">
                            <b>
                                {{ member.name }}
                                {% if member.isMe %}
                                    {{ translate('(vous)') }}
                                {% endif %}
                            </b>
                            <span class="admin-row__meta">
                                {{ translate('{email} · {loginInfo}', {
                                    email: member.email,
                                    loginInfo: member.pending ? translate('invitation en attente') : translate('dernière connexion {date}', { date: member.lastLogin })
                                }) }}
                            </span>
                        </span>
                        {% if member.isMe %}
                            <span class="admin-badge">
                                {{ member.roleLabel }}
                            </span>
                        {% else %}
                            <span class="admin-row__actions">
                                <form method="post" action="{{ path('admin_team_role', { id: member.id }) }}" class="admin-form admin-form--inline">
                                    {{ csrf_field('admin_team')|raw }}
                                    <select name="role" class="admin-select" aria-label="{{ translate('Rôle de {name}', { name: member.name }) }}" data-admin-auto>
                                        {% for role in roles %}
                                            <option value="{{ role.value }}"{{ role.value == member.role ? ' selected' : '' }}>
                                                {{ role.label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="admin-button admin-button--small" data-admin-apply>
                                        {{ translate('Changer') }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_team_revoke', { id: member.id }) }}">
                                    {{ csrf_field('admin_team')|raw }}
                                    <button type="submit" class="admin-button admin-button--small admin-button--ghost-danger" data-admin-confirm="{{ translate("Retirer l'accès de {name} ?", { name: member.name }) }}">
                                        {{ translate('Retirer') }}
                                    </button>
                                </form>
                            </span>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Inviter un membre') }}
            </h2>
            <form method="post" action="{{ path('admin_team_invite') }}" class="admin-form">
                {{ csrf_field('admin_team')|raw }}
                <div class="admin-form__row">
                    <label class="admin-field">
                        {{ translate('Prénom') }}
                        <input type="text" name="firstName" required maxlength="80" class="admin-input">
                    </label>
                    <label class="admin-field">
                        {{ translate('Nom') }}
                        <input type="text" name="lastName" maxlength="80" class="admin-input">
                    </label>
                </div>
                <label class="admin-field">
                    {{ translate('E-mail') }}
                    <input type="email" name="email" required maxlength="180" class="admin-input">
                </label>
                <label class="admin-field">
                    {{ translate('Rôle') }}
                    <select name="role" class="admin-input" required>
                        {% for role in roles %}
                            <option value="{{ role.value }}"{{ role.value == 'ROLE_SUPPORT' ? ' selected' : '' }}>
                                {{ role.label }}
                            </option>
                        {% endfor %}
                    </select>
                    <span class="admin-field__hint">
                        {{ translate('Support : réservations. Modération : pros, signalements, utilisateurs. Admin : tout.') }}
                    </span>
                </label>
                <div class="admin-actions">
                    <button type="submit" class="admin-button admin-button--primary">
                        {{ translate("Envoyer l'invitation") }}
                    </button>
                </div>
            </form>
        </section>
    </div>
{% endblock %}