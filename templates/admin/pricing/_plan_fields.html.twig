<div class="admin-form__row">
    <label class="admin-field">
        {{ translate('Nom') }}
        <input type="text" name="name" value="{{ plan.name ?? '' }}" required minlength="2" maxlength="80" class="admin-input">
    </label>
    <label class="admin-field">
        {{ translate('Facturation') }}
        <select name="billing" class="admin-input">
            {% for billing in billings %}
                <option value="{{ billing.value }}"{{ billing.value == (plan.billing ?? 'subscription') ? ' selected' : '' }}>
                    {{ billing.label }}
                </option>
            {% endfor %}
        </select>
    </label>
</div>
<label class="admin-field">
    {{ translate('Description') }}
    <input type="text" name="description" value="{{ plan.description ?? '' }}" maxlength="255" class="admin-input">
</label>
<div class="admin-form__row admin-form__row--3">
    <label class="admin-field">
        {{ translate('Prix HT') }}
        <span class="admin-field__hint">
            {{ translate('en centimes (3900 = 39 €)') }}
        </span>
        <input type="number" name="price" value="{{ plan.price ?? 0 }}" min="0" required class="admin-input">
    </label>
    <label class="admin-field">
        {{ translate('Prix annuel HT') }}
        <span class="admin-field__hint">
            {{ translate('en centimes, 0 si aucun') }}
        </span>
        <input type="number" name="yearlyPrice" value="{{ plan.yearlyPrice ?? 0 }}" min="0" class="admin-input">
    </label>
    <label class="admin-field">
        {{ translate('TVA (%)') }}
        <span class="admin-field__hint">
            &nbsp;
        </span>
        <input type="number" name="vatRate" value="{{ plan.vatRate ?? 20 }}" min="0" max="100" required class="admin-input">
    </label>
</div>
<div class="admin-form__row admin-form__row--3">
    <label class="admin-field">
        {{ translate('Essai (jours)') }}
        <input type="number" name="trialDays" value="{{ plan.trialDays ?? 0 }}" min="0" max="90" required class="admin-input">
    </label>
    <label class="admin-field">
        {{ translate('Engagement (mois)') }}
        <input type="number" name="commitmentMonths" value="{{ plan.commitmentMonths ?? 0 }}" min="0" max="36" required class="admin-input">
    </label>
    <label class="admin-field">
        {{ translate('Établissements max') }}
        <input type="number" name="maxEstablishments" value="{{ plan.maxEstablishments ?? 1 }}" min="1" max="1000" class="admin-input">
    </label>
</div>
<div class="admin-actions">
    {% for flag, label in {
        unlimitedEstablishments: translate('Établissements illimités'),
        commissionFree: translate('Sans commission'),
        featured: translate('Mise en avant'),
        advancedStats: translate('Statistiques avancées'),
        active: translate('Active')
    } %}
        {% set checked = flag == 'unlimitedEstablishments' ? (plan is defined and plan.maxEstablishments is null) : (plan[flag] ?? (flag == 'active')) %}
        <label class="admin-check">
            <input type="hidden" name="{{ flag }}" value="0">
            <input type="checkbox" name="{{ flag }}" value="1" class="admin-check__input"{{ checked ? ' checked' : '' }}>
            {{ label }}
        </label>
    {% endfor %}
</div>