{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'pricing' %}
{% set editable = selected.editable %}

{% block title %}
    {{ translate('Tarifs et formules · Administration Kréno') }}
{% endblock %}

{% block content %}
    <div class="admin-head">
        <div>
            <h1 class="admin-title">
                {{ translate('Tarifs et formules') }}
            </h1>
            <span class="admin-subtitle">
                Version {{ selected.code }} · {{ selected.statusLabel }}
                {% if pricing.pricingName %}
                    · {{ pricing.pricingName }}
                {% endif %}
            </span>
        </div>
        <form method="get" action="{{ path('admin_pricing_index') }}" class="admin-toolbar">
            <select name="version" class="admin-select" aria-label="Version du site" data-admin-auto>
                {% for version in versions %}
                    <option value="{{ version.code }}"{{ version.code == selected.code ? ' selected' : '' }}>
                        {{ version.code }} · {{ version.name }} ({{ version.statusLabel|lower }})
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-button" data-admin-apply>
                {{ translate('Afficher') }}
            </button>
        </form>
    </div>

    {% if kpis %}
        <div class="admin-stats">
            {% for kpi in kpis %}
                <div class="admin-stat">
                    <span class="admin-stat__label">
                        {{ kpi.label }}
                    </span>
                    <strong class="admin-stat__value{{ kpi.tone == 'danger' ? ' admin-stat__value--alert' : '' }}">
                        {{ kpi.value }}
                    </strong>
                    <span class="admin-stat__note">
                        {{ kpi.note }}
                    </span>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {% if not editable %}
        <div class="admin-note">
            {{ translate('Cette version n\'est plus modifiable. Duplique-la depuis « Versions du site » pour préparer une nouvelle grille tarifaire.') }}
        </div>
    {% elseif pricing.changedPlans is not empty %}
        <div class="admin-note">
            {{ translate('Prix modifiés par rapport à la version en ligne : {changedPlans}', {
                changedPlans: pricing.changedPlans|join(', ')
            }) }}
        </div>
    {% endif %}

    <div class="admin-grid">
        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Formules') }}
            </h2>
            <div class="admin-rows">
                {% for plan in pricing.plans %}
                    <div class="admin-row">
                        <span class="admin-row__main">
                            <b>
                                {{ plan.name }}
                                {% if plan.featured %}
                                    {{ translate('· mise en avant') }}
                                {% endif %}
                            </b>
                            <span class="admin-row__meta">
                                {{ plan.priceLabel }} {{ plan.unitLabel }}
                                {% if plan.trialDays %}
                                    {{ translate('· essai {trialDays} j', {trialDays: plan.trialDays}) }}
                                {% endif %}
                                {% if plan.maxEstablishments %}
                                    {{ translate('· {count, plural, =1 {# établissement max} other {# établissements max}}', {
                                        count: plan.maxEstablishments
                                    }) }}
                                {% else %}
                                    {{ translate('· établissements illimités') }}
                                {% endif %}
                            </span>
                            {% if plan.changed %}
                                <span class="admin-diff">
                                    {{ translate('En ligne : {livePriceLabel}', {livePriceLabel: plan.livePriceLabel}) }}
                                </span>
                            {% elseif plan.isNew and selected.status != 'live' %}
                                <span class="admin-diff">
                                    {{ translate('Nouvelle formule') }}
                                </span>
                            {% endif %}
                        </span>
                        <span class="admin-badge admin-badge--{{ plan.active ? 'success' : 'neutral' }}">
                            {% if plan.active %}
                                {{ translate('Active') }}
                            {% else %}
                                {{ translate('Inactive') }}
                            {% endif %}
                        </span>
                        {% if editable %}
                            <details class="admin-disclosure admin-disclosure--full">
                                <summary class="admin-disclosure__summary">
                                    {{ translate('Modifier') }}
                                </summary>
                                <form method="post" action="{{ path('admin_pricing_plan_update', { code: selected.code, planCode: plan.code }) }}" class="admin-form admin-disclosure__body" data-admin-strip>
                                    {{ csrf_field('admin_pricing')|raw }}
                                    {% include 'admin/pricing/_plan_fields.html.twig' with { plan: plan } %}
                                    <div class="admin-actions">
                                        <button type="submit" class="admin-button admin-button--primary">
                                            {{ translate('Enregistrer') }}
                                        </button>
                                    </div>
                                </form>
                            </details>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="admin-subtitle">
                        {{ translate('Aucune formule.') }}
                    </p>
                {% endfor %}
            </div>
            {% if editable %}
                <details class="admin-disclosure">
                    <summary class="admin-disclosure__summary">
                        {{ translate('Ajouter une formule') }}
                    </summary>
                    <form method="post" action="{{ path('admin_pricing_plan_create', { code: selected.code }) }}" class="admin-form admin-disclosure__body" data-admin-strip>
                        {{ csrf_field('admin_pricing')|raw }}
                        <label class="admin-field">
                            {{ translate('Code') }}
                            <input type="text" name="code" required pattern="[a-z0-9\-]{2,40}" placeholder="premium" class="admin-input">
                        </label>
                        {% include 'admin/pricing/_plan_fields.html.twig' %}
                        <div class="admin-actions">
                            <button type="submit" class="admin-button admin-button--primary">
                                {{ translate('Ajouter') }}
                            </button>
                        </div>
                    </form>
                </details>
            {% endif %}
        </section>

        <div class="admin-form">
            <section class="admin-card">
                <h2 class="admin-card__title">
                    {{ translate('Changement de prix') }}
                </h2>
                <form method="post" action="{{ path('admin_pricing_policy', { code: selected.code }) }}" class="admin-form">
                    {{ csrf_field('admin_pricing')|raw }}
                    <label class="admin-field">
                        {{ translate('Nom de la grille') }}
                        <input type="text" name="pricingName" value="{{ pricing.pricingName }}" minlength="2" maxlength="120" required class="admin-input"{{ editable ? '' : ' disabled' }}>
                    </label>
                    <label class="admin-field">
                        {{ translate('Abonnés existants') }}
                        <select name="policy" class="admin-input"{{ editable ? '' : ' disabled' }}>
                            {% for policy in policies %}
                                <option value="{{ policy.value }}"{{ policy.value == pricing.priceChangePolicy ? ' selected' : '' }}>
                                    {{ policy.label }}
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="admin-field">
                        {{ translate('Préavis (jours)') }}
                        <input type="number" name="noticeDays" value="{{ pricing.priceChangeNoticeDays }}" min="0" max="90" required class="admin-input"{{ editable ? '' : ' disabled' }}>
                    </label>
                    {% if editable %}
                        <div class="admin-actions">
                            <button type="submit" class="admin-button admin-button--primary">
                                {{ translate('Enregistrer') }}
                            </button>
                        </div>
                    {% endif %}
                </form>
            </section>

            <section class="admin-card">
                <h2 class="admin-card__title">
                    {{ translate('Codes promo') }}
                </h2>
                <div class="admin-rows">
                    {% for promo in pricing.promoCodes %}
                        <div class="admin-row">
                            <span class="admin-row__main">
                                <b>{{ promo.code }}</b>
                                <span class="admin-row__meta">
                                    {% if promo.discountPercent %}
                                        {{ translate('-{percent} % pendant {duration} mois', {
                                            percent: promo.discountPercent,
                                            duration: promo.durationMonths
                                        }) }}
                                    {% endif %}

                                    {% if promo.freeMonths %}
                                        {{ translate('{hasDiscount, select, true {· } other {}}{count, plural, =1 {# mois offert} other {# mois offerts}}', {
                                            hasDiscount: promo.discountPercent ? 'true' : 'false',
                                            count: promo.freeMonths
                                        }) }}
                                    {% endif %}

                                    {{ translate('· {uses}{maxUses} {count, plural, =1 {utilisation} other {utilisations}}', {
                                        uses: promo.usesCount,
                                        maxUses: promo.maxUses ? '/' ~ promo.maxUses : '',
                                        count: promo.usesCount
                                    }) }}

                                    {% if promo.endsAt %}
                                        {{ translate('· jusqu\'au {date}', {
                                            date: promo.endsAt|date('d/m/Y')
                                        }) }}
                                    {% endif %}
                                </span>
                            </span>
                            <span class="admin-badge admin-badge--{{ promo.status == 'active' ? 'success' : 'neutral' }}">
                                {% if promo.status == 'active' %}
                                    {{ translate('Actif') }}
                                {% else %}
                                    {{ translate('Terminé') }}
                                {% endif %}
                            </span>
                            {% if editable %}
                                <details class="admin-disclosure admin-disclosure--full">
                                    <summary class="admin-disclosure__summary">
                                        {{ translate('Modifier') }}
                                    </summary>
                                    <form method="post" action="{{ path('admin_pricing_promo_update', { code: selected.code, promoCode: promo.code }) }}" class="admin-form admin-disclosure__body" data-admin-strip>
                                        {{ csrf_field('admin_pricing')|raw }}
                                        {% include 'admin/pricing/_promo_fields.html.twig' with { promo: promo } %}
                                        <div class="admin-actions">
                                            <button type="submit" class="admin-button admin-button--primary">
                                                {{ translate('Enregistrer') }}
                                            </button>
                                        </div>
                                    </form>
                                </details>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="admin-subtitle">
                            {{ translate('Aucun code promo.') }}
                        </p>
                    {% endfor %}
                </div>
                {% if editable %}
                    <details class="admin-disclosure">
                        <summary class="admin-disclosure__summary">
                            {{ translate('Créer un code promo') }}
                        </summary>
                        <form method="post" action="{{ path('admin_pricing_promo_create', { code: selected.code }) }}" class="admin-form admin-disclosure__body" data-admin-strip>
                            {{ csrf_field('admin_pricing')|raw }}
                            {% include 'admin/pricing/_promo_fields.html.twig' %}
                            <div class="admin-actions">
                                <button type="submit" class="admin-button admin-button--primary">
                                    {{ translate('Créer') }}
                                </button>
                            </div>
                        </form>
                    </details>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}