{% extends 'layouts/admin.html.twig' %}

{% set admin_section = 'faq' %}

{% macro order(route, parameters, field, values, index, step, label, icon) %}
    {% set target = index + step %}
    {% if target >= 0 and target < values|length %}
        {% set reordered = [] %}
        {% for position, value in values %}
            {% set reordered = reordered|merge([
                position == index ? values[target] : (position == target ? values[index] : value)
            ]) %}
        {% endfor %}
        <form method="post" action="{{ path(route, parameters) }}">
            {{ csrf_field('admin_faq')|raw }}
            {% for value in reordered %}
                <input type="hidden" name="{{ field }}[]" value="{{ value }}">
            {% endfor %}
            <button type="submit" class="admin-button admin-button--small" aria-label="{{ label }}">
                <i data-lucide="{{ icon }}" class="admin-nav__icon"></i>
            </button>
        </form>
    {% endif %}
{% endmacro %}

{% macro switch(route, parameters, visible, label) %}
    <form method="post" action="{{ path(route, parameters) }}">
        {{ csrf_field('admin_faq')|raw }}
        <button type="submit"
                class="faq-switch{{ visible ? ' faq-switch--on' : '' }}"
                role="switch"
                aria-checked="{{ visible ? 'true' : 'false' }}"
                aria-label="{{ visible ? translate('Masquer') : translate('Afficher') }} {{ label }}"
        >
            <span class="faq-switch__knob"></span>
        </button>
    </form>
{% endmacro %}

{% macro audienceSelect(choices, selected) %}
    <label class="admin-field">
        {{ translate('Public') }}
        <select name="audience" class="admin-input">
            {% for choice in choices %}
                <option value="{{ choice.value }}"{{ choice.value == selected ? ' selected' : '' }}>
                    {{ choice.label }}
                </option>
            {% endfor %}
        </select>
    </label>
{% endmacro %}

{% block title %}
    {{ translate('FAQ · Administration Kréno') }}
{% endblock %}

{% block content %}
    {% import _self as faq %}

    <h1 class="admin-title">
        {{ translate('FAQ') }}
    </h1>

    <div class="faq-admin">
        {% for audience in audiences %}
            <section class="admin-card">
                <h2 class="admin-card__title">
                    {{ audience.label }}
                    <span class="faq-admin__page">
                        {{ audience.page }}
                    </span>
                </h2>
                <div class="admin-rows">
                    {% for category in audience.categories %}
                        <div class="admin-row">
                            <span class="admin-row__main">
                                <b>
                                    {{ category.name }}
                                </b>
                                <span class="admin-row__meta">
                                    {{ translate('{slug} · {count, plural, =1 {# question} other {# questions}}', {
                                        slug: category.slug,
                                        count: category.questionsCount
                                    }) }}
                                </span>
                            </span>
                            <span class="admin-row__actions">

                                {{ faq.order(
                                    'admin_faq_category_order',
                                    {},
                                    'slugs',
                                    audience.slugs,
                                    loop.index0,
                                    -1,
                                    translate('Monter {name}', {name: category.name}),
                                    'arrow-up'
                                ) }}

                                {{ faq.order(
                                    'admin_faq_category_order',
                                    {},
                                    'slugs',
                                    audience.slugs,
                                    loop.index0,
                                    1,
                                    translate('Descendre {name}', {name: category.name}),
                                    'arrow-down'
                                ) }}

                                {{ faq.switch(
                                    'admin_faq_category_visibility',
                                    {
                                        slug: category.slug
                                    },
                                    category.visible,
                                    category.name
                                ) }}

                                <a href="{{ path('admin_faq_category_show', { slug: category.slug }) }}"
                                   class="admin-button admin-button--small">
                                    {{ translate('Modifier') }}
                                </a>
                            </span>
                        </div>
                    {% else %}
                        <p class="admin-subtitle">
                            {{ translate('Aucune rubrique pour ce public.') }}
                        </p>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Nouvelle rubrique') }}
            </h2>
            <form method="post" action="{{ path('admin_faq_category_create') }}" class="admin-form">
                {{ csrf_field('admin_faq')|raw }}
                <div class="admin-form__row">
                    <label class="admin-field">
                        {{ translate('Nom') }}
                        <input type="text"
                               name="name"
                               required
                               minlength="2"
                               maxlength="80"
                               placeholder="{{ translate('Réserver') }}"
                               class="admin-input"
                        >
                    </label>

                    {{ faq.audienceSelect(
                        audienceChoices,
                        'client'
                    ) }}
                </div>
                <div class="admin-actions">
                    <button type="submit" class="admin-button admin-button--primary">
                        {{ translate('Ajouter') }}
                    </button>
                </div>
            </form>
        </section>

        <section class="admin-card">
            <h2 class="admin-card__title">
                {{ translate('Valeurs automatiques') }}
            </h2>
            <span class="admin-subtitle">
                {{ translate('Ces repères sont remplacés dans les réponses par la valeur des règles de la version en ligne.') }}
            </span>
            <dl class="faq-placeholders">
                {% for placeholder in placeholders %}
                    <div class="faq-placeholders__item">
                        <dt class="faq-placeholders__token">
                            {{ placeholder.token }}
                        </dt>
                        <dd class="faq-placeholders__label">
                            {{ placeholder.label }}
                        </dd>
                    </div>
                {% endfor %}
            </dl>
        </section>
    </div>
{% endblock %}